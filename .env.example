# Production PostgreSQL (Aliyun RDS or AWS RDS)
DATABASE_URL=
RAILS_MASTER_KEY=
SECRET_KEY_BASE=
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2
APP_HOST=localhost
APP_HOSTS=localhost
FORCE_SSL=true

# Object storage: aliyun_oss or amazon_s3
ACTIVE_STORAGE_SERVICE=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# OpenAI-compatible provider. Keep the key only in a local environment variable.
AI_BASE_URL=https://api.minimax.cn/v1
AI_API_KEY=
AI_MODEL=MiniMax-M3
AI_PROVIDER=minimax

# Authorized tender JSON API credentials. Store only this variable name in a TenderSource record.
# TENDER_SOURCE_EXAMPLE_API_KEY=

# OCR worker
OCR_WORKER_URL=
OCR_WORKER_TOKEN=

# Local SQLite overrides (optional; Docker/PostgreSQL are not required locally)
SQLITE_DATABASE=storage/development.sqlite3
SQLITE_TEST_DATABASE=storage/test.sqlite3

# Production background processing
JOB_CONCURRENCY=3
JOB_DB_POOL=10
# Required in production: four distinct database names, possibly on the same RDS instance.
QUEUE_DATABASE_URL=
CACHE_DATABASE_URL=
CABLE_DATABASE_URL=
