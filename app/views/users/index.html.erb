<% content_for :title, "用户与权限｜江苏东华 AI 工作平台" %><% content_for :page_title, "系统管理" %><div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><h1 class="text-2xl font-bold">用户与权限</h1><p class="mt-2 text-sm text-slate-500">账户停用不会删除历史记录；项目访问还受项目成员关系限制。</p></div><div class="flex flex-wrap gap-2"><%= link_to "部门", departments_path, class: "rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold" %><%= link_to "角色权限", roles_path, class: "rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold" %><%= link_to "新建用户", new_user_path, class: "rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white" %></div></div><div class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"><div class="overflow-x-auto"><table class="min-w-full divide-y divide-slate-200 text-sm"><thead class="bg-slate-50 text-left text-xs uppercase tracking-wider text-slate-500"><tr><th class="px-5 py-3.5">用户</th><th class="px-5 py-3.5">部门</th><th class="px-5 py-3.5">角色</th><th class="px-5 py-3.5">状态</th><th></th></tr></thead><tbody class="divide-y divide-slate-100"><% @users.each do |user| %><tr><td class="px-5 py-4"><p class="font-semibold"><%= user.name %></p><p class="mt-1 text-xs text-slate-500"><%= user.email %></p></td><td class="px-5 py-4"><%= user.department&.name || "—" %></td><td class="px-5 py-4"><%= user.roles.map(&:name).join("、").presence || "无角色" %></td><td class="px-5 py-4"><%= user.active? ? "启用" : "停用" %></td><td class="px-5 py-4 text-right"><%= link_to "编辑", edit_user_path(user), class: "font-semibold text-cyan-700" %></td></tr><% end %></tbody></table></div></div>
