<%= form_with model: user, class: "space-y-6" do |form| %><%= render "shared/errors", record: user %><div class="grid gap-5 md:grid-cols-2"><div><%= form.label :name, "姓名", class: "mb-1.5 block text-sm font-semibold" %><%= form.text_field :name, required: true, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div><div><%= form.label :email, "邮箱", class: "mb-1.5 block text-sm font-semibold" %><%= form.email_field :email, required: true, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div><div><%= form.label :department_id, "所属部门", class: "mb-1.5 block text-sm font-semibold" %><%= form.collection_select :department_id, Department.where(active: true).order(:name), :id, :name, { include_blank: "未分配" }, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div><div><%= form.label :status, "账户状态", class: "mb-1.5 block text-sm font-semibold" %><%= form.select :status, [["启用", "active"], ["停用", "disabled"]], {}, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div><div><%= form.label :password, user.persisted? ? "重置密码（留空不变）" : "初始密码", class: "mb-1.5 block text-sm font-semibold" %><%= form.password_field :password, required: !user.persisted?, minlength: 12, autocomplete: "new-password", class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div><div><%= form.label :password_confirmation, "确认密码", class: "mb-1.5 block text-sm font-semibold" %><%= form.password_field :password_confirmation, required: !user.persisted?, minlength: 12, autocomplete: "new-password", class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div></div><fieldset><legend class="text-sm font-semibold">系统角色</legend><div class="mt-3 grid gap-3 sm:grid-cols-2"><%= form.collection_check_boxes :role_ids, Role.order(:name), :id, :name do |box| %><label class="flex items-center gap-3 rounded-xl border border-slate-200 p-3 text-sm"><%= box.check_box class: "size-4 rounded" %><%= box.text %></label><% end %></div></fieldset><div class="flex justify-end gap-3 border-t border-slate-100 pt-5"><%= link_to "取消", users_path, class: "rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-600" %><%= form.submit user.persisted? ? "保存用户" : "创建用户", class: "cursor-pointer rounded-xl bg-slate-950 px-5 py-2.5 text-sm font-semibold text-white" %></div><% end %>
