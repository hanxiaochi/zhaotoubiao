<% content_for :title, "#{@user.name}｜用户" %><% content_for :page_title, "用户资料" %><div class="mx-auto max-w-3xl rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><h1 class="text-2xl font-bold"><%= @user.name %></h1><p class="mt-2 text-slate-500"><%= @user.email %></p><dl class="mt-6 space-y-3 text-sm"><div><dt class="text-slate-500">部门</dt><dd class="font-medium"><%= @user.department&.name || "—" %></dd></div><div><dt class="text-slate-500">角色</dt><dd class="font-medium"><%= @user.roles.map(&:name).join("、").presence || "无" %></dd></div></dl></div>
