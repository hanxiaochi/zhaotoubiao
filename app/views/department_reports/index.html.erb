<% content_for :page_title, "部门业务汇总" %>
<% filters = params.permit(:department_id, :type, :status, :from, :to, :view).to_h %>
<% totals = @report.totals %>
<div class="flex items-start justify-between gap-4"><div><h1 class="text-2xl font-bold">部门业务汇总</h1><p class="mt-2 text-sm text-slate-500">仅统计当前账号可见项目，含历史归档；未分配部门单独列示，不按成员数量重复计数。</p></div><%= link_to "导出汇总 CSV", department_reports_path(filters.merge(format: :csv)), data: { turbo: false }, class: "whitespace-nowrap rounded-md bg-slate-900 px-4 py-2 text-sm text-white" %></div>
<nav aria-label="统计视图" class="desktop-toolbar"><%= link_to "全部可见业务", department_reports_path %><%= link_to "已完成招标业务", department_reports_path(view: "completed_tenders") %><span class="text-xs text-slate-500"><%= params[:view] == "completed_tenders" ? "当前：已完成或归档的招标代理、投标项目" : "当前：全部可见项目" %></span></nav>
<%= form_with url: department_reports_path, method: :get, class: "mt-4 grid gap-3 rounded-lg border border-slate-200 bg-white p-4 lg:grid-cols-3 xl:grid-cols-6" do |f| %>
  <%= f.hidden_field :view, value: params[:view] if params[:view].present? %>
  <div><%= f.label :department_id, "部门", class: "block text-xs text-slate-600" %><%= f.select :department_id, options_for_select([["全部可见部门", ""], ["未分配部门", "unassigned"]] + @departments.map { |d| [d.name, d.id] }, params[:department_id]), {}, class: "mt-1 w-full rounded-md border border-slate-300 p-2 text-sm" %></div>
  <div><%= f.label :type, "业务类型", class: "block text-xs text-slate-600" %><%= f.select :type, options_for_select([["全部类型", ""]] + ApplicationHelper::PROJECT_TYPE_LABELS.map { |k,v| [v,k] }, params[:type]), {}, class: "mt-1 w-full rounded-md border border-slate-300 p-2 text-sm" %></div>
  <div><%= f.label :status, "项目阶段", class: "block text-xs text-slate-600" %><%= f.select :status, options_for_select([["全部阶段", ""]] + Project::STATUSES.map { |s| [status_label(s),s] }, params[:status]), {}, class: "mt-1 w-full rounded-md border border-slate-300 p-2 text-sm" %></div>
  <div><%= f.label :from, "项目开始日期起", class: "block text-xs text-slate-600" %><%= f.date_field :from, value: params[:from], class: "mt-1 w-full rounded-md border border-slate-300 p-2 text-sm" %></div>
  <div><%= f.label :to, "项目开始日期止", class: "block text-xs text-slate-600" %><%= f.date_field :to, value: params[:to], class: "mt-1 w-full rounded-md border border-slate-300 p-2 text-sm" %></div>
  <div class="flex items-end gap-3"><%= f.submit "查询", class: "cursor-pointer rounded-md bg-slate-900 px-4 py-2 text-sm text-white" %><%= link_to "重置", department_reports_path, class: "py-2 text-sm text-slate-600" %></div>
<% end %>
<p class="mt-2 text-xs leading-5 text-slate-500">口径：日期筛选项目开始日期，非收费发生日期；费用为所选项目全部累计人民币金额。未收与溢收按收费记录分别汇总，不相互抵销；债权只计笔数，不混加不同币种金额。超期仅统计截止日期早于今天的在办项目。</p>
<div class="mt-4 grid gap-3 lg:grid-cols-4">
  <% [["可见项目", totals[:projects]], ["在办 / 超期", "#{totals[:ongoing]} / #{totals[:overdue]}"], ["应收 / 实收", "#{money(totals[:receivable])} / #{money(totals[:received])}"], ["待收 / 溢收", "#{money(totals[:outstanding])} / #{money(totals[:overpaid])}"]].each do |label,value| %>
    <div class="rounded-lg border border-slate-200 bg-white p-4"><p class="text-xs text-slate-500"><%= label %></p><p class="mt-2 text-lg font-bold tabular-nums"><%= value %></p></div>
  <% end %>
</div>
<section class="mt-4 overflow-hidden rounded-lg border border-slate-200 bg-white">
  <h2 class="border-b border-slate-200 p-4 font-bold">部门台账</h2>
  <div class="overflow-x-auto"><table class="ledger-table"><caption class="sr-only">部门项目、债权及收费汇总</caption><thead><tr><th scope="col">部门</th><th scope="col" class="numeric">项目 / 在办</th><th scope="col" class="numeric">完成 / 归档</th><th scope="col" class="numeric">超期</th><th scope="col" class="numeric">债权 / 待审</th><th scope="col" class="numeric">应收 / 实收</th><th scope="col" class="numeric">未收 / 溢收</th><th scope="col">明细</th></tr></thead><tbody>
  <% @report.rows.each do |row| %><tr><td class="font-semibold"><%= row[:name] %></td><td class="numeric"><%= row[:projects] %> / <%= row[:ongoing] %></td><td class="numeric"><%= row[:completed] %> / <%= row[:archived] %></td><td class="numeric"><%= row[:overdue] %></td><td class="numeric"><%= row[:claims] %> / <%= row[:pending_claims] %></td><td class="numeric"><%= money(row[:receivable]) %><br><span class="text-xs text-slate-500"><%= money(row[:received]) %></span></td><td class="numeric"><%= money(row[:outstanding]) %><br><span class="text-xs text-slate-500"><%= money(row[:overpaid]) %></span></td><td><%= link_to "查看", department_reports_path(filters.merge(department_id: row[:department_id] || "unassigned")), class: "text-sm font-semibold text-cyan-700" %></td></tr><% end %>
  <% if @report.rows.empty? %><tr><td colspan="8" class="text-center text-slate-500">当前权限及筛选条件下没有项目。</td></tr><% end %>
  </tbody></table></div>
</section>
<section class="mt-4 rounded-lg border border-slate-200 bg-white p-4"><h2 class="font-bold">业务构成</h2><div class="mt-3 grid gap-4 lg:grid-cols-3"><% @report.types.each do |type,count| %><div><div class="mb-1 flex justify-between text-xs"><span><%= project_type_label(type) %></span><span><%= count %> 项</span></div><progress value="<%= count %>" max="<%= [totals[:projects],1].max %>" aria-label="<%= project_type_label(type) %>项目占比" class="h-2 w-full accent-cyan-700"><%= count %></progress></div><% end %><% if @report.types.empty? %><p class="text-sm text-slate-500">暂无业务数据。</p><% end %></div></section>
<section class="mt-4 overflow-hidden rounded-lg border border-slate-200 bg-white"><h2 class="border-b border-slate-200 p-4 font-bold">统计范围内的项目</h2><div class="overflow-x-auto"><table class="ledger-table"><thead><tr><th scope="col">项目 / 编号</th><th scope="col">部门</th><th scope="col">负责人</th><th scope="col">状态</th><th scope="col">开始 / 截止</th><th scope="col">操作</th></tr></thead><tbody>
<% @projects.each do |project| %><tr><td><%= project.name %><p class="text-xs text-slate-500"><%= project.code %></p></td><td><%= project.department&.name || "未分配部门" %></td><td><%= project.owner&.name || "未指定" %></td><td><%= status_badge(project.status) %></td><td class="text-xs"><%= project.start_date || "未设置" %> / <%= project.due_date || "未设置" %></td><td><%= link_to "进入项目", project, class: "text-sm font-semibold text-cyan-700" %></td></tr><% end %>
<% if @projects.empty? %><tr><td colspan="6" class="text-center text-slate-500">暂无项目明细。</td></tr><% end %>
</tbody></table></div></section>
<nav aria-label="项目明细分页" class="mt-4 flex justify-between text-sm"><span>共 <%= totals[:projects] %> 项 · 第 <%= @page %> 页（汇总不受分页影响）</span><div class="flex gap-4"><% if @page > 1 %><%= link_to "上一页", department_reports_path(filters.merge(page: @page - 1)) %><% end %><% if @page * 30 < totals[:projects] %><%= link_to "下一页", department_reports_path(filters.merge(page: @page + 1)) %><% end %></div></nav>
