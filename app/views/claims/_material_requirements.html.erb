<fieldset class="sm:col-span-2 xl:col-span-4 rounded-md border border-slate-200 bg-slate-50 p-3">
  <legend class="px-1 text-sm font-semibold">本项适用规则</legend>
  <div class="grid gap-3 lg:grid-cols-4"><% { "material_requirement" => "是否要求本材料", "signature_requirement" => "签字要求", "seal_requirement" => "盖章要求", "authorization_requirement" => "授权要求" }.each do |field, label| %>
    <div><%= form.label field, label, for: "material_#{material.id}_#{field}", class: "mb-1 block text-sm text-slate-600" %><%= form.select field, ClaimMaterial::REQUIREMENT_OPTIONS, {}, id: "material_#{material.id}_#{field}", class: "w-full rounded-md border border-slate-300 bg-white p-2 text-sm" %></div>
  <% end %></div>
  <div class="mt-3"><%= form.label :requirement_note, "适用依据 / 不适用说明", for: "material_#{material.id}_requirement_note", class: "block text-sm text-slate-600" %><%= form.text_field :requirement_note, id: "material_#{material.id}_requirement_note", placeholder: "根据申报主体、代理情况及本项目制度填写；不适用时必填", class: "mt-1 w-full rounded-md border border-slate-300 bg-white p-2 text-sm" %></div>
</fieldset>
