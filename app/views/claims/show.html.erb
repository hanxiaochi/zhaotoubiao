<% content_for :title, "#{@claim.creditor_name}｜债权申报" %><% content_for :page_title, "债权审核" %>

<div class="flex flex-col justify-between gap-4 lg:flex-row lg:items-start"><div><%= link_to "← 返回项目", @claim.project, class: "text-sm font-semibold text-cyan-700" %><div class="mt-3 flex flex-wrap items-center gap-2"><%= status_badge(@claim.status) %><span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600"><%= claim_type_label(@claim.claimed_type) %></span></div><h1 class="mt-3 text-2xl font-bold"><%= @claim.creditor_name %></h1><p class="mt-2 text-sm text-slate-500"><%= @claim.project.name %></p></div><div class="flex flex-wrap gap-2"><%= link_to "编辑申报", edit_claim_path(@claim), class: "rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold hover:bg-slate-50" if policy(@claim).update? %><%= button_to "AI 合理性与分类建议", ai_suggest_claim_path(@claim), method: :post, class: "rounded-xl bg-cyan-800 px-4 py-2.5 text-sm font-semibold text-white" if policy(@claim).update? %></div></div>

<div class="mt-6 grid gap-4 sm:grid-cols-3"><div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><p class="text-xs font-semibold text-slate-500">申报金额</p><p class="mt-2 text-2xl font-bold"><%= money(@claim.claim_amount, currency: @claim.currency) %></p></div><div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><p class="text-xs font-semibold text-slate-500">材料收齐度（不含签章核验）</p><p class="mt-2 text-2xl font-bold"><%= @claim.completeness_score || 0 %>%</p></div><div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><p class="text-xs font-semibold text-slate-500">审核记录</p><p class="mt-2 text-2xl font-bold"><%= @reviews.size %></p></div></div>

<%= render "supplements" %>
<%= render "workflow_gate" %>
<div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1.45fr)_minmax(340px,0.75fr)]">
  <div class="space-y-6">
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"><div class="border-b border-slate-100 px-5 py-4"><h2 class="font-bold">材料核验清单</h2><p class="mt-1 text-xs text-slate-500">请查看来源原件后逐项记录人工核验；OCR 仅提供线索，不鉴定签章真伪。</p></div><div class="divide-y divide-slate-100">
      <% @materials.each do |material| %>
        <% if policy(@claim).update? %>
        <% present_id = "material_#{material.id}_present"; signature_id = "material_#{material.id}_signature"; seal_id = "material_#{material.id}_seal" %>
        <%= form_with model: [@claim, material], class: "grid gap-3 px-5 py-4 sm:grid-cols-2 xl:grid-cols-4 xl:items-end" do |form| %>
          <div class="sm:col-span-2 xl:col-span-4"><p class="font-semibold"><%= material.material_type %></p><p class="mt-1 text-xs text-slate-500"><%= material.checked_by ? "由 #{material.checked_by.name} 核验" : "尚未人工核验" %><%= " · 系统置信度 #{material.extraction_confidence}%" if material.extraction_confidence %></p></div>
          <div><%= form.label :present, "是否已提供", for: present_id, class: "mb-1 block text-xs font-medium text-slate-500" %><%= form.select :present, [["未提供", false], ["已提供", true]], {}, id: present_id, class: "w-full rounded-lg border border-slate-300 px-2.5 py-2 text-sm" %></div>
          <div><%= form.label :signature_detected, "签字人工核验", for: signature_id, class: "mb-1 block text-xs font-medium text-slate-500" %><%= form.select :signature_detected, [["未核验", nil], ["核验通过", true], ["核验未通过", false]], {}, id: signature_id, class: "w-full rounded-lg border border-slate-300 px-2.5 py-2 text-sm" %></div>
          <div><%= form.label :seal_detected, "盖章人工核验", for: seal_id, class: "mb-1 block text-xs font-medium text-slate-500" %><%= form.select :seal_detected, [["未核验", nil], ["核验通过", true], ["核验未通过", false]], {}, id: seal_id, class: "w-full rounded-lg border border-slate-300 px-2.5 py-2 text-sm" %></div>
          <div><%= form.label :authorization_complete, "授权委托", class: "mb-1 block text-xs font-medium text-slate-500" %><%= form.select :authorization_complete, [["未核验", nil], ["完整", true], ["不完整", false]], {}, class: "w-full rounded-lg border border-slate-300 px-2.5 py-2 text-sm" %></div>
          <div class="sm:col-span-2"><%= form.label :project_document_id, "来源文件", class: "mb-1 block text-xs font-medium text-slate-500" %><%= form.collection_select :project_document_id, @project_documents, :id, :original_filename, { include_blank: "未关联" }, class: "w-full rounded-lg border border-slate-300 px-2.5 py-2 text-sm" %></div>
          <div><%= form.label :page_reference, "来源页码", class: "mb-1 block text-xs font-medium text-slate-500" %><%= form.text_field :page_reference, placeholder: "如：第 3 页", class: "w-full rounded-lg border border-slate-300 px-2.5 py-2 text-sm" %></div>
          <div><%= form.label :extraction_confidence, "识别置信度 %", class: "mb-1 block text-xs font-medium text-slate-500" %><%= form.number_field :extraction_confidence, min: 0, max: 100, step: 0.01, class: "w-full rounded-lg border border-slate-300 px-2.5 py-2 text-sm" %></div>
          <div class="sm:col-span-2 xl:col-span-3"><%= form.label :note, "核验备注", class: "mb-1 block text-xs font-medium text-slate-500" %><%= form.text_field :note, placeholder: "记录识别依据、疑点或补正要求", class: "w-full rounded-lg border border-slate-300 px-2.5 py-2 text-sm" %></div>
          <%= render "material_requirements", form: form, material: material %>
          <%= form.submit "保存核验", class: "cursor-pointer rounded-lg bg-slate-800 px-3 py-2 text-sm font-semibold text-white hover:bg-slate-950" %>
        <% end %>
        <% else %>
          <%= render "material_readonly", material: material %>
        <% end %>
      <% end %>
    </div></section>

    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-bold">事实与理由</h2><p class="mt-3 whitespace-pre-line text-sm leading-7 text-slate-700"><%= @claim.summary.presence || "暂无说明" %></p><dl class="mt-5 grid gap-4 border-t border-slate-100 pt-4 text-sm sm:grid-cols-2"><div><dt class="text-slate-500">统一社会信用代码</dt><dd class="mt-1 font-medium"><%= @claim.unified_code.presence || "—" %></dd></div><div><dt class="text-slate-500">联系人</dt><dd class="mt-1 font-medium"><%= [@claim.contact_name, @claim.contact_phone].compact_blank.join(" / ").presence || "—" %></dd></div></dl></section>

    <% if @claim.analysis_data.present? %><section class="rounded-2xl border border-amber-200 bg-amber-50 p-5"><div class="flex flex-wrap items-center justify-between gap-2"><h2 class="font-bold text-amber-950">AI 辅助分析（已人工批准写回）</h2><span class="rounded-full bg-white px-2.5 py-1 text-xs font-semibold text-amber-800">候选分类 <%= claim_type_label(@claim.recommended_type) %> · 风险 <%= @claim.risk_level %></span></div><p class="mt-3 text-sm leading-7 text-amber-950"><%= @claim.analysis_data["analysis_summary"] %></p><div class="mt-4 grid gap-4 md:grid-cols-3"><% [["事实冲突", "conflicts"], ["待核法律依据", "legal_basis"], ["缺失证据", "missing_evidence"]].each do |title, key| %><div class="rounded-xl bg-white/70 p-4"><h3 class="text-sm font-bold"><%= title %></h3><ul class="mt-2 list-disc space-y-1 pl-4 text-xs leading-5"><% Array(@claim.analysis_data[key]).each do |item| %><li><%= item %></li><% end %><% if Array(@claim.analysis_data[key]).empty? %><li class="list-none text-slate-500">未发现或未提供</li><% end %></ul></div><% end %></div><p class="mt-3 text-xs text-amber-800">本区内容不是法律意见或债权认定，最终结论仍以审核轨迹为准。</p></section><% end %>

    <% if @ai_runs.any? %><section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"><div class="border-b border-slate-100 px-5 py-4"><h2 class="font-bold">AI 辅助任务证据链</h2></div><div class="divide-y divide-slate-100"><% @ai_runs.each do |run| %><%= link_to run, class: "flex items-center justify-between gap-3 px-5 py-4 hover:bg-slate-50" do %><div><p class="text-sm font-semibold"><%= run.task_type %></p><p class="mt-1 text-xs text-slate-500"><%= l(run.created_at, format: :default) %> · <%= run.model || "等待执行" %> · <%= run.evidence_refs.size %> 份来源</p></div><%= status_badge(run.status) %><% end %><% end %></div></section><% end %>

    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-bold">审核轨迹</h2><% if @reviews.any? %><div class="mt-4 space-y-4"><% @reviews.each do |review| %><div class="border-l-2 border-cyan-500 pl-4"><div class="flex flex-wrap items-center justify-between gap-2"><p class="text-sm font-semibold"><%= review.reviewer.name %> · <%= ClaimReviewFlow::STAGE_LABELS.fetch(review.stage, review.stage) %> · <%= { "approve" => "本层通过", "request_supplement" => "要求补正", "reject" => "驳回" }.fetch(review.decision, review.decision) %></p><p class="text-xs text-slate-400"><%= l(review.created_at, format: :default) %></p></div><p class="mt-2 text-sm leading-6 text-slate-600"><%= review.comment %></p><%= render "review_snapshot", review: review %></div><% end %></div><% else %><p class="mt-4 text-sm text-slate-500">尚无审核意见。</p><% end %></section>
  </div>

  <aside class="space-y-6">
    <% if policy(@claim).review? %><section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-bold">提交审核意见</h2><p class="mt-1 text-xs leading-5 text-slate-500">当前层级：<strong><%= @review_flow.stage_label %></strong>。系统按经办、专业、项目负责人、负责人终审顺序推进，每次操作写入不可修改轨迹。</p><% if @review_flow.allowed? %><%= form_with url: review_claim_path(@claim), class: "mt-4 space-y-4" do |form| %><%= form.hidden_field :stage, value: @claim.review_stage %><div><%= form.label :decision, "处理意见", class: "mb-1.5 block text-sm font-semibold" %><%= form.select :decision, [[@claim.review_stage == "principal" ? "通过并完成终审" : "本层通过并流转下一级", "approve"], ["要求补充材料", "request_supplement"], ["驳回", "reject"]], {}, class: "w-full rounded-xl border border-slate-300 px-3 py-2.5" %></div><div><%= form.label :comment, "审核说明", class: "mb-1.5 block text-sm font-semibold" %><%= form.text_area :comment, required: true, rows: 5, placeholder: "说明依据、疑点及后续动作", class: "w-full rounded-xl border border-slate-300 px-3 py-2.5" %></div><%= form.submit "记录审核结论", data: { turbo_confirm: "确认提交该审核意见？提交后记录不可删除。" }, class: "w-full cursor-pointer rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white hover:bg-cyan-800" %><% end %><% else %><p class="mt-4 rounded-xl bg-slate-50 px-4 py-3 text-sm text-slate-600">您可查看审核记录，但当前层级需由对应角色处理。</p><% end %></section><% end %>
    <section class="rounded-2xl border border-amber-200 bg-amber-50 p-5"><p class="text-xs font-bold uppercase tracking-wider text-amber-800">责任边界</p><p class="mt-2 text-sm leading-6 text-amber-950">系统可提示材料缺失、签章区域及事实矛盾，但不得自动认定签章真伪、债权性质或最终金额。</p></section>
  </aside>
</div>
