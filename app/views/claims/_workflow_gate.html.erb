<section class="mt-4 rounded-lg border border-slate-200 bg-white p-4">
  <div class="flex items-center justify-between gap-4"><div><h2 class="font-bold">当前层级前置审批 / 会签</h2><p class="mt-1 text-sm text-slate-500"><%= @review_flow.stage_label %>：<%= @claim.status.in?(%w[approved rejected]) ? "审核已结束，以下仅展示该层级历史任务。" : "新建债权任务绑定当前材料版本。全部通过后，仍由本层审核人员确认流转。" %></p></div>
    <% if policy(@claim).create? && !@claim.status.in?(%w[approved rejected supplement_required]) %><%= link_to "发起本层任务", new_project_workflow_task_path(@claim.project, record_ref: "Claim:#{@claim.public_id}"), class: "shrink-0 rounded-md bg-slate-900 px-3 py-2 text-sm text-white" %><% end %>
  </div>
  <% if @gate_issues.any? %><ul role="status" class="mt-3 list-disc space-y-1 rounded-md bg-amber-50 p-3 pl-7 text-sm text-amber-900"><% @gate_issues.each do |issue| %><li><%= issue %></li><% end %></ul><% end %>
  <% @claim_tasks.each do |task| %><div class="mt-3 flex items-center justify-between border-t border-slate-100 pt-3 text-sm"><%= link_to task.stage, task, class: "font-semibold text-cyan-700" %><span><%= status_badge(task.status) %><%= " · 依据已变化" unless task.claim_basis_current? %></span></div><% end %>
  <% if @claim_tasks.empty? %><p class="mt-3 text-sm text-slate-500">本层未安排额外前置任务，按四级岗位权限审核。旧版未绑定层级的任务仅作历史记录，不作为已会签凭证。</p><% end %>
</section>
