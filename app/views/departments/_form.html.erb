<%= form_with model: department, class: "space-y-6" do |form| %><%= render "shared/errors", record: department %><div><%= form.label :code, "部门代码", class: "mb-1.5 block text-sm font-semibold" %><%= form.text_field :code, required: true, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div><div><%= form.label :name, "部门名称", class: "mb-1.5 block text-sm font-semibold" %><%= form.text_field :name, required: true, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div><label class="flex items-center gap-3"><%= form.check_box :active, class: "size-4 rounded" %><span class="text-sm font-semibold">启用部门</span></label><div class="flex justify-end gap-3 border-t border-slate-100 pt-5"><%= link_to "取消", departments_path, class: "rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-600" %><%= form.submit "保存部门", class: "cursor-pointer rounded-xl bg-slate-950 px-5 py-2.5 text-sm font-semibold text-white" %></div><% end %>
