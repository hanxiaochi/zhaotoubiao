<% content_for :title, "部门管理｜江苏东华 AI 工作平台" %><% content_for :page_title, "系统管理" %><div class="flex justify-between gap-4"><div><h1 class="text-2xl font-bold">部门管理</h1><p class="mt-2 text-sm text-slate-500">停用部门不会删除用户、项目或历史记录。</p></div><%= link_to "新建部门", new_department_path, class: "h-fit rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white" %></div><div class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"><table class="min-w-full divide-y divide-slate-200 text-sm"><thead class="bg-slate-50 text-left text-xs uppercase tracking-wider text-slate-500"><tr><th class="px-5 py-3.5">部门</th><th class="px-5 py-3.5">用户</th><th class="px-5 py-3.5">项目</th><th class="px-5 py-3.5">状态</th><th></th></tr></thead><tbody class="divide-y divide-slate-100"><% @departments.each do |department| %><tr><td class="px-5 py-4 font-semibold"><%= department.name %><p class="mt-1 text-xs font-normal text-slate-400"><%= department.code %></p></td><td class="px-5 py-4"><%= department.users.size %></td><td class="px-5 py-4"><%= department.projects.size %></td><td class="px-5 py-4"><%= department.active? ? "启用" : "停用" %></td><td class="px-5 py-4 text-right"><%= link_to "编辑", edit_department_path(department), class: "font-semibold text-cyan-700" %></td></tr><% end %></tbody></table></div>
