<% content_for :title, "角色权限｜江苏东华 AI 工作平台" %><% content_for :page_title, "系统管理" %><div class="flex justify-between gap-4"><div><h1 class="text-2xl font-bold">角色权限</h1><p class="mt-2 text-sm text-slate-500">管理员角色始终拥有全部权限，不能在界面中削弱。</p></div><%= link_to "新建角色", new_role_path, class: "h-fit rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white" %></div><div class="mt-6 grid gap-4 md:grid-cols-2"><% @roles.each do |role| %><div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><div class="flex justify-between gap-3"><div><h2 class="font-bold"><%= role.name %></h2><p class="mt-1 text-xs text-slate-500"><%= role.code %> · <%= role.users.size %> 人</p></div><%= link_to "编辑", edit_role_path(role), class: "text-sm font-semibold text-cyan-700" if policy(role).update? %></div><div class="mt-4 flex flex-wrap gap-2"><% if role.code == "admin" %><span class="rounded-full bg-rose-50 px-2.5 py-1 text-xs font-semibold text-rose-700">全部权限</span><% else %><% role.permissions.each do |permission| %><span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs text-slate-600"><%= Role::AVAILABLE_PERMISSIONS.fetch(permission, permission) %></span><% end %><% end %></div></div><% end %></div>
