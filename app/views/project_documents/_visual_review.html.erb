<% pages = Array(@project_document.metadata["ocr_pages"]).select { |page| page.is_a?(Hash) && Ocr::VisualReview.valid?(page["visual_review"]) } %>
<% if pages.any? %>
  <section class="mt-6 border-t border-slate-100 pt-5">
    <h2 class="font-bold">签章图像候选区域</h2>
    <p class="mt-2 text-sm leading-6 text-slate-600">本地图像规则扫描红色区域及签字标签右侧墨迹；不是签名或印章鉴真。候选可能是印刷字或标志，未发现也不代表原件不存在；不会自动更新债权材料的人工核验状态。</p>
    <p class="mt-2 text-xs text-slate-500">位置按原件当前页左上角为起点，以页面宽高的百分比表示。请下载原件，按物理页码及区域核对；黑白印章、浅色或重叠手写可能漏检。</p>
    <div class="mt-4 space-y-3">
      <% pages.each do |page| %>
        <% review = page["visual_review"]; candidates = Array(review["candidates"]) %>
        <details class="rounded-lg border border-slate-200 bg-slate-50 p-4" <%= "open" if candidates.any? %>>
          <summary class="cursor-pointer text-sm font-semibold">第 <%= page["page"] %> 页 · <%= candidates.size %> 处图像候选 · 检查 <%= review["signature_labels_examined"].to_i %> 个签字标签</summary>
          <% if candidates.empty? %><p class="mt-3 text-sm text-slate-500">当前规则未发现候选，请仍查看原件人工核验。</p><% end %>
          <% candidates.each do |candidate| %>
            <div class="mt-3 rounded-md border border-amber-200 bg-white p-3 text-sm">
              <p class="font-semibold text-amber-900"><%= candidate["kind"] == "red_seal_candidate" ? "疑似红色印章区域" : "签字位置附近墨迹" %></p>
              <p class="mt-1 text-slate-600"><%= candidate["basis"] %></p>
              <p class="mt-2 font-mono text-xs text-slate-500">左 <%= (candidate["bbox"][0] * 100).round(1) %>% · 上 <%= (candidate["bbox"][1] * 100).round(1) %>% · 右 <%= (candidate["bbox"][2] * 100).round(1) %>% · 下 <%= (candidate["bbox"][3] * 100).round(1) %>%</p>
            </div>
          <% end %>
          <% if review["omitted_candidates"].to_i.positive? %><p class="mt-3 text-sm text-amber-900">另有 <%= review["omitted_candidates"] %> 处候选未展开，请逐页核查原件。</p><% end %>
        </details>
      <% end %>
    </div>
    <%= link_to "下载原件核对签章", download_project_project_document_path(@project, @project_document), class: "mt-4 inline-flex rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white" %>
  </section>
<% elsif @project_document.ocr_status == "completed" %>
  <p class="mt-4 rounded-lg bg-amber-50 p-3 text-sm text-amber-900">本次结果不含签章图像区域检查。旧PDF/图片结果可重新解析；Office、TXT/CSV需查看原件或转为PDF后检查，文字关键词不等于已签字盖章。</p>
<% end %>
