<div data-controller="job-monitor" data-job-monitor-status-value="<%= @project_document.ocr_status %>">
<% content_for :title, "#{@project_document.original_filename}｜项目文件" %><% content_for :page_title, "项目文件" %><div class="mx-auto max-w-4xl"><%= link_to "← 返回项目", @project, class: "text-sm font-semibold text-cyan-700" %><div class="mt-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start"><div><%= status_badge(@project_document.status) %><h1 class="mt-3 break-all text-xl font-bold"><%= @project_document.original_filename %></h1><p class="mt-2 text-sm text-slate-500"><%= document_category_label(@project_document.category) %> · <%= number_to_human_size(@project_document.byte_size) %></p></div><div class="flex flex-wrap gap-2"><%= button_to "提取文本/OCR", analyze_project_project_document_path(@project, @project_document), method: :post, class: "rounded-xl bg-cyan-800 px-4 py-2.5 text-sm font-semibold text-white", disabled: @project_document.ocr_status.in?(%w[queued processing]) if policy(@project_document).update? %><%= link_to "下载原件", download_project_project_document_path(@project, @project_document), class: "rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white" %><%= link_to "据此登记债权", new_project_claim_path(@project, source_document_id: @project_document.public_id), class: "rounded-xl border border-cyan-300 bg-cyan-50 px-4 py-2.5 text-sm font-semibold text-cyan-900" if @project_document.ocr_text.present? && policy(Claim.new(project: @project)).create? %><%= button_to "归档", archive_project_project_document_path(@project, @project_document), method: :patch, class: "rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-semibold" if policy(@project_document).archive? %></div></div><dl class="mt-6 grid gap-4 border-t border-slate-100 pt-5 text-sm sm:grid-cols-2"><div><dt class="text-slate-500">内容类型</dt><dd class="mt-1 font-medium"><%= @project_document.content_type %></dd></div><div><dt class="text-slate-500">上传人员</dt><dd class="mt-1 font-medium"><%= @project_document.uploaded_by.name %></dd></div><div class="sm:col-span-2"><dt class="text-slate-500">SHA-256 校验摘要</dt><dd class="mt-1 break-all rounded-lg bg-slate-50 p-3 font-mono text-xs"><%= @project_document.sha256 %></dd></div><div><dt class="text-slate-500">OCR 状态</dt><dd class="mt-1 font-medium"><%= status_label(@project_document.ocr_status) %></dd></div><div><dt class="text-slate-500">智能分析状态</dt><dd class="mt-1 font-medium"><%= status_label(@project_document.analysis_status) %></dd></div></dl><%= render "extraction_notices" %><% if @project_document.classification.present? %><div class="mt-6 rounded-xl border border-amber-200 bg-amber-50 p-4"><p class="text-xs font-bold text-amber-800">材料分类候选</p><p class="mt-1 font-semibold text-amber-950"><%= @project_document.classification %> · 置信度 <%= @project_document.classification_confidence %>%</p><p class="mt-1 text-xs text-amber-800"><%= @project_document.metadata["classification_reason"] %></p></div><% end %><% if @project_document.extracted_fields.any? %><div class="mt-6 border-t border-slate-100 pt-5"><h2 class="font-bold">结构化字段候选</h2><dl class="mt-3 grid gap-3 sm:grid-cols-2"><% @project_document.extracted_fields.each do |field, value| %><div class="rounded-xl bg-slate-50 p-3"><dt class="text-xs text-slate-500"><%= t("ocr_fields.#{field}", default: field) %></dt><dd class="mt-1 text-sm font-semibold"><%= value %></dd><% source = @project_document.metadata.dig("field_sources", field) %><p class="mt-1 text-xs text-slate-400"><%= Ocr::SourceLabel.call(source) %></p></div><% end %></dl></div><% end %><% if @project_document.ocr_text.present? %><div class="mt-6 border-t border-slate-100 pt-5"><h2 class="font-bold">提取文本</h2><pre class="mt-3 max-h-96 overflow-auto whitespace-pre-wrap rounded-xl bg-slate-50 p-4 text-xs leading-6"><%= @project_document.ocr_text %></pre></div><% end %></div></div>
</div>
