<% content_for :title, "上传项目文件｜江苏东华 AI 工作平台" %><% content_for :page_title, "项目文件" %><div class="mx-auto max-w-3xl"><div class="mb-6"><%= link_to "← 返回项目", @project, class: "text-sm font-semibold text-cyan-700" %><h1 class="mt-3 text-2xl font-bold">上传项目文件</h1><p class="mt-2 text-sm text-slate-500">支持 PDF、Word、Excel、图片、TXT 和 CSV，单文件不超过 50 MB。系统会记录 SHA-256 摘要。</p></div><div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><%= form_with model: [@project, @project_document], class: "space-y-6", data: { controller: "upload", action: "submit->upload#submit", turbo: false } do |form| %><%= render "shared/errors", record: @project_document %><div><%= form.label :category, "文件类别", class: "mb-1.5 block text-sm font-semibold" %><%= form.select :category, [["接管资料", "intake"], ["债权材料", "claim"], ["审计底稿", "working_paper"], ["招标文件", "tender"], ["投标文件", "bid"], ["合同", "contract"], ["其他", "other"]], {}, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div><div><%= form.label :file, "选择文件", class: "mb-1.5 block text-sm font-semibold" %><%= form.file_field :file, required: true, accept: ".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.tif,.tiff,.txt,.csv", class: "block w-full rounded-xl border border-dashed border-slate-300 bg-slate-50 px-4 py-8 text-sm" %></div><%= render "upload_progress" %><div class="flex justify-end gap-3 border-t border-slate-100 pt-5"><%= link_to "取消", @project, class: "rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-600" %><%= form.submit "安全上传", data: { upload_target: "submit" }, class: "cursor-pointer rounded-xl bg-slate-950 px-5 py-2.5 text-sm font-semibold text-white hover:bg-cyan-800" %></div><% end %></div></div>
