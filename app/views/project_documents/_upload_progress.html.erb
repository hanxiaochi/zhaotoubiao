<div class="space-y-3" aria-label="文件传输进度">
  <progress data-upload-target="progress" max="100" value="0" hidden class="h-2 w-full accent-cyan-700" aria-label="已传输百分比"></progress>
  <p data-upload-target="status" role="status" aria-live="polite" class="text-sm text-slate-600">文件仅上传至本项目；发送 AI 需要另行操作。</p>
  <button data-upload-target="cancel" data-action="upload#cancel" type="button" hidden class="rounded-lg border border-slate-300 px-3 py-2 text-sm">取消传输</button>
</div>
