<% content_for :title, "招标数据源｜江苏东华 AI 工作平台" %><% content_for :page_title, "招标数据源" %><div class="flex justify-between gap-4"><div><h1 class="text-2xl font-bold">授权数据源</h1><p class="mt-2 text-sm text-slate-500">只有明确确认授权的数据源才能启用；API 密钥只允许通过环境变量配置。</p></div><%= link_to "新增数据源", new_tender_source_path, class: "h-fit rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white" %></div><div class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"><table class="min-w-full divide-y divide-slate-200 text-sm"><thead class="bg-slate-50 text-left text-xs uppercase tracking-wider text-slate-500"><tr><th class="px-5 py-3.5">名称</th><th class="px-5 py-3.5">接入方式</th><th class="px-5 py-3.5">授权</th><th class="px-5 py-3.5">最近同步</th><th></th></tr></thead><tbody class="divide-y divide-slate-100"><% @sources.each do |source| %><tr><td class="px-5 py-4 font-semibold"><%= source.name %><p class="mt-1 max-w-md truncate text-xs font-normal text-slate-400"><%= source.base_url %></p></td><td class="px-5 py-4"><%= source.access_mode %></td><td class="px-5 py-4"><%= source.authorized? ? "已确认" : "未确认" %> · <%= source.active? ? "启用" : "停用" %></td><td class="px-5 py-4 text-xs text-slate-500"><%= source.last_synced_at ? l(source.last_synced_at, format: :short) : "尚未同步" %></td><td class="px-5 py-4 text-right"><div class="flex justify-end gap-3"><% if source.syncable? %><%= button_to "立即同步", sync_tender_source_path(source), method: :post, class: "font-semibold text-emerald-700" %><% end %><%= link_to "编辑", edit_tender_source_path(source), class: "font-semibold text-cyan-700" %></div></td></tr><% end %></tbody></table><% unless @sources.any? %><p class="py-14 text-center text-sm text-slate-500">暂无数据源。</p><% end %></div>
