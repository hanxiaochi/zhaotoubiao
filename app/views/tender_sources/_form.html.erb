<%= form_with model: source, class: "space-y-6" do |form| %><%= render "shared/errors", record: source %><div><%= form.label :name, "数据源名称", class: "mb-1.5 block text-sm font-semibold" %><%= form.text_field :name, required: true, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div><div><%= form.label :base_url, "JSON API 地址", class: "mb-1.5 block text-sm font-semibold" %><%= form.url_field :base_url, required: true, placeholder: "https://example.gov.cn/api/notices", class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %><p class="mt-1.5 text-xs text-slate-500">自动同步仅访问 HTTPS JSON API，不执行网页模拟登录、验证码绕过或反爬规避。</p></div><div><%= form.label :access_mode, "接入方式", class: "mb-1.5 block text-sm font-semibold" %><%= form.select :access_mode, [["公开 API", "public_api"], ["授权商业 API", "licensed_api"], ["人工导入", "manual_import"]] + (Rails.env.development? ? [["本地演示数据", "demo"]] : []), {}, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div><div><%= form.label :credential_env_key, "凭据环境变量名", class: "mb-1.5 block text-sm font-semibold" %><%= form.text_field :credential_env_key, placeholder: "例如 JIANGSU_TENDER_API_TOKEN", class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5 font-mono" %><p class="mt-1.5 text-xs text-slate-500">这里只保存变量名，API 密钥必须在服务器运行环境中配置，绝不写入数据库。</p></div><div class="rounded-xl border border-amber-200 bg-amber-50 p-4"><div class="flex items-start gap-3"><%= form.check_box :authorized, class: "mt-1 size-4 rounded" %><div><%= form.label :authorized, "我已核实并确认该数据源允许本系统接入", class: "text-sm font-semibold text-amber-950" %><p class="mt-1 text-xs leading-5 text-amber-800">该勾选仅记录内部授权确认，不替代合同、许可或网站条款。</p></div></div></div><div class="flex items-center gap-3"><%= form.check_box :active, class: "size-4 rounded" %><%= form.label :active, "启用数据源", class: "text-sm font-semibold" %></div><div class="flex justify-end gap-3 border-t border-slate-100 pt-5"><%= link_to "取消", tender_sources_path, class: "rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-600" %><%= form.submit "保存数据源", class: "cursor-pointer rounded-xl bg-slate-950 px-5 py-2.5 text-sm font-semibold text-white" %></div><% end %>
