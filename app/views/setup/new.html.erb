<% content_for :title, "初始化系统｜江苏东华 AI 工作平台" %>
<div class="rounded-3xl border border-white/10 bg-white p-7 shadow-2xl shadow-black/30">
  <div class="mb-6">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-cyan-700">首次使用</p>
    <h1 class="mt-2 text-2xl font-bold tracking-tight">创建系统管理员</h1>
    <p class="mt-2 text-sm leading-6 text-slate-500">管理员拥有系统配置和审计权限。密码至少 12 位，建议使用密码管理器生成。</p>
  </div>
  <%= form_with model: @user, url: setup_path, class: "space-y-4" do |form| %>
    <%= render "shared/errors", record: @user %>
    <div><%= form.label :name, class: "mb-1.5 block text-sm font-semibold" %><%= form.text_field :name, required: true, autofocus: true, autocomplete: "name", class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5 outline-none focus:border-cyan-600 focus:ring-2 focus:ring-cyan-600/20" %></div>
    <div><%= form.label :email, class: "mb-1.5 block text-sm font-semibold" %><%= form.email_field :email, required: true, autocomplete: "email", class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5 outline-none focus:border-cyan-600 focus:ring-2 focus:ring-cyan-600/20" %></div>
    <div><%= form.label :password, class: "mb-1.5 block text-sm font-semibold" %><%= form.password_field :password, required: true, minlength: 12, autocomplete: "new-password", class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5 outline-none focus:border-cyan-600 focus:ring-2 focus:ring-cyan-600/20" %></div>
    <div><%= form.label :password_confirmation, class: "mb-1.5 block text-sm font-semibold" %><%= form.password_field :password_confirmation, required: true, minlength: 12, autocomplete: "new-password", class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5 outline-none focus:border-cyan-600 focus:ring-2 focus:ring-cyan-600/20" %></div>
    <%= form.submit "完成初始化", class: "w-full cursor-pointer rounded-xl bg-slate-950 px-4 py-3 font-semibold text-white transition hover:bg-cyan-800" %>
  <% end %>
</div>
