<% content_for :title, "审计日志｜江苏东华 AI 工作平台" %><% content_for :page_title, "审计日志" %>
<div><h1 class="text-2xl font-bold">审计日志</h1><p class="mt-2 text-sm text-slate-500">最近 200 条关键操作。审计事件在应用层禁止修改和删除。</p></div>
<div class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"><div class="overflow-x-auto"><table class="min-w-full divide-y divide-slate-200 text-sm"><thead class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wider text-slate-500"><tr><th class="px-5 py-3.5">时间</th><th class="px-5 py-3.5">操作人</th><th class="px-5 py-3.5">动作</th><th class="px-5 py-3.5">对象</th><th class="px-5 py-3.5">请求标识</th></tr></thead><tbody class="divide-y divide-slate-100"><% @events.each do |event| %><tr class="align-top"><td class="whitespace-nowrap px-5 py-4 text-slate-600"><%= l(event.occurred_at, format: :default) %></td><td class="px-5 py-4 font-medium"><%= event.actor&.name || "系统" %></td><td class="px-5 py-4"><code class="rounded bg-slate-100 px-2 py-1 text-xs"><%= event.action %></code></td><td class="px-5 py-4 text-slate-600"><%= event.record_type %><p class="mt-1 max-w-52 truncate text-xs text-slate-400" title="<%= event.record_public_id %>"><%= event.record_public_id || event.record_id %></p></td><td class="px-5 py-4"><p class="max-w-48 truncate text-xs text-slate-400" title="<%= event.request_id %>"><%= event.request_id || "—" %></p></td></tr><% end %></tbody></table></div><% unless @events.any? %><div class="px-5 py-14 text-center text-sm text-slate-500">暂无审计事件。</div><% end %></div>
