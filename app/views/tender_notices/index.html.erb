<% content_for :title, "招标信息｜江苏东华 AI 工作平台" %><% content_for :page_title, "招标信息" %><div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><h1 class="text-2xl font-bold">招标信息台账</h1><p class="mt-2 text-sm text-slate-500">汇总授权数据源和人工登记信息；是否参与投标由人员判断。</p></div><% if policy(TenderNotice).create? %><%= link_to "人工登记", new_tender_notice_path, class: "rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white" %><% end %></div><%= form_with url: tender_notices_path, method: :get, class: "mt-6 grid gap-3 rounded-2xl border border-slate-200 bg-white p-4 sm:grid-cols-4" do |form| %><%= form.text_field :region, value: params[:region], placeholder: "地区", class: "rounded-xl border border-slate-300 px-3 py-2.5 text-sm" %><%= form.text_field :industry, value: params[:industry], placeholder: "行业", class: "rounded-xl border border-slate-300 px-3 py-2.5 text-sm" %><%= form.select :status, options_for_select([["全部状态", ""], ["新信息", "new"], ["跟进中", "tracking"], ["已报名", "applied"], ["已忽略", "ignored"], ["已截止", "expired"]], params[:status]), {}, class: "rounded-xl border border-slate-300 px-3 py-2.5 text-sm" %><%= form.submit "筛选", class: "cursor-pointer rounded-xl bg-slate-800 px-4 py-2.5 text-sm font-semibold text-white" %><% end %><div class="mt-5 space-y-3"><% @notices.each do |notice| %><%= link_to notice, class: "block rounded-2xl border border-slate-200 bg-white p-5 shadow-sm hover:border-cyan-300" do %><div class="flex flex-col justify-between gap-3 sm:flex-row"><div><h2 class="font-bold"><%= notice.title %></h2><p class="mt-2 text-sm text-slate-500"><%= [notice.region, notice.industry, notice.tender_source&.name || "人工登记"].compact.join(" · ") %></p></div><div class="shrink-0 text-right"><%= status_badge(notice.status) %><p class="mt-2 text-xs text-slate-500"><%= notice.deadline_at ? "截止 #{l(notice.deadline_at, format: :short)}" : "未登记截止时间" %></p></div></div><% end %><% end %></div><% unless @notices.any? %><div class="mt-5 rounded-2xl border border-dashed border-slate-300 py-16 text-center text-sm text-slate-500">暂无符合条件的招标信息。</div><% end %>
