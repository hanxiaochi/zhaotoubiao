<%= form_with model: analysis.persisted? ? analysis : [project, analysis], class: "space-y-6" do |form| %><%= render "shared/errors", record: analysis %><div><%= form.label :criteria_text, "评分点（每行一项）", class: "mb-1.5 block text-sm font-semibold" %><%= form.text_area :criteria_text, rows: 8, placeholder: "技术方案完整性（30分）\n项目团队资质（20分）", class: "w-full rounded-xl border border-slate-300 px-3.5 py-3 font-mono text-sm leading-6" %></div><div><%= form.label :risks_text, "风险与缺口（每行一项）", class: "mb-1.5 block text-sm font-semibold" %><%= form.text_area :risks_text, rows: 6, placeholder: "项目经理证书有效期需核验", class: "w-full rounded-xl border border-slate-300 px-3.5 py-3 text-sm leading-6" %></div><div><%= form.label :outline_text, "技术标提纲（每行一项）", class: "mb-1.5 block text-sm font-semibold" %><%= form.text_area :outline_text, rows: 8, placeholder: "一、项目理解\n二、实施方案\n三、质量保障", class: "w-full rounded-xl border border-slate-300 px-3.5 py-3 text-sm leading-6" %></div><div><%= form.label :simulated_score, "模拟评分（0-100）", class: "mb-1.5 block text-sm font-semibold" %><%= form.number_field :simulated_score, min: 0, max: 100, step: 0.01, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %><p class="mt-1.5 text-xs text-slate-500">模拟分数是内部自检，不代表评标专家或中标结果。</p></div><%= render "review_section_fields", form: form %><div class="flex justify-end gap-3 border-t border-slate-100 pt-5"><%= link_to "取消", analysis.persisted? ? analysis : project, class: "rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-600" %><%= form.submit analysis.persisted? ? "保存分析草稿" : "创建分析草稿", class: "cursor-pointer rounded-xl bg-slate-950 px-5 py-2.5 text-sm font-semibold text-white" %></div><% end %>
