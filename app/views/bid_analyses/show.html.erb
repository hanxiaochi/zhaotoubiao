<%= render "bid_analyses/draft_entry" %>
<% content_for :title, "投标分析｜#{@analysis.project.name}" %><% content_for :page_title, "投标分析" %><div class="flex flex-col justify-between gap-4 sm:flex-row"><div><%= link_to "← 返回项目", @analysis.project, class: "text-sm font-semibold text-cyan-700" %><div class="mt-3"><%= status_badge(@analysis.status) %></div><h1 class="mt-3 text-2xl font-bold"><%= @analysis.project.name %> · 投标分析</h1></div><div class="flex h-fit gap-2"><%= link_to "编辑草稿", edit_bid_analysis_path(@analysis), class: "rounded-md border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold" if policy(@analysis).update? %><%= button_to "AI 辅助分析", ai_suggest_bid_analysis_path(@analysis), method: :post, class: "rounded-md bg-cyan-800 px-4 py-2.5 text-sm font-semibold text-white" if policy(AiRun.new(record: @analysis, project: @analysis.project)).create? %></div></div><div class="mt-6 grid gap-6 xl:grid-cols-3"><section class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-bold">评分点</h2><ol class="mt-4 list-decimal space-y-2 pl-5 text-sm leading-6 text-slate-700"><% @analysis.criteria.each do |item| %><li><%= item %></li><% end %></ol></section><section class="rounded-lg border border-rose-200 bg-rose-50 p-5"><h2 class="font-bold text-rose-950">风险与缺口</h2><ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-6 text-rose-900"><% @analysis.risks.each do |item| %><li><%= item %></li><% end %></ul></section><section class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-bold"><%= @scoring.rows.any? ? "逐项自评分汇总" : "历史 / AI 参考分" %></h2><p class="mt-4 text-4xl font-black"><%= @scoring.rows.any? ? number_with_precision(@scoring.awarded, precision: 2) : (@analysis.simulated_score || "—") %><span class="text-base font-medium text-slate-400"> / 100</span></p><p class="mt-3 text-xs leading-5 text-slate-500">仅用于内部自检，不预测中标结果。</p></section></div><%= render "review_sections" %><%= render "simulations" %><%= render "scoring" %><%= render "evidence" %><section class="mt-6 rounded-lg border border-slate-200 bg-white p-6 shadow-sm"><h2 class="font-bold">技术标提纲</h2><ol class="mt-4 space-y-3 text-sm leading-7"><% @analysis.outline.each_with_index do |item, index| %><li class="flex gap-3"><span class="grid size-6 shrink-0 place-items-center rounded-full bg-cyan-50 text-xs font-bold text-cyan-800"><%= index + 1 %></span><%= item %></li><% end %></ol></section><% if @ai_runs.any? %><section class="mt-6 overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm"><div class="border-b border-slate-100 px-5 py-4"><h2 class="font-bold">AI 辅助任务</h2><p class="text-xs text-slate-500">输出需人工批准后才能写回</p></div><div class="divide-y divide-slate-100"><% @ai_runs.each do |run| %><%= link_to run, class: "flex items-center justify-between gap-3 px-5 py-4 hover:bg-slate-50" do %><div><p class="text-sm font-semibold"><%= ai_task_label(run.task_type) %></p><p class="mt-1 text-xs text-slate-500"><%= l(run.created_at, format: :default) %> · <%= run.model || "等待执行" %></p></div><%= status_badge(run.status) %><% end %><% end %></div></section><% end %><% if policy(@analysis).review? %><section class="mt-6 rounded-lg border border-slate-200 bg-white p-6 shadow-sm"><h2 class="font-bold">人工复核</h2><% if @analysis.reviewed_at %><p class="mt-3 text-sm text-slate-600">由 <%= @analysis.reviewed_by.name %> 于 <%= l(@analysis.reviewed_at, format: :default) %> 复核：<%= @analysis.review_note %></p><% else %><%= form_with url: review_bid_analysis_path(@analysis), class: "mt-4 flex flex-col gap-3 sm:flex-row" do |form| %><%= form.text_field :review_note, required: true, placeholder: "说明复核依据和边界", class: "min-w-0 flex-1 rounded-md border border-slate-300 px-3.5 py-2.5 text-sm" %><%= form.submit "确认人工复核", class: "cursor-pointer rounded-md bg-slate-950 px-5 py-2.5 text-sm font-semibold text-white" %><% end %><% end %></section><% end %>
