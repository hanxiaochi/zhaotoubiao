<section class="mt-6 grid gap-4 xl:grid-cols-2" aria-label="投标专项清单">
  <% BidAnalysis::REVIEW_SECTIONS.each do |field, title| %>
    <article class="rounded-lg border border-slate-200 bg-white p-5">
      <h2 class="font-bold"><%= title %></h2>
      <p class="mt-2 text-xs leading-5 text-slate-500"><%= field == "suggested_tasks" ? "建议不会自动派发。创建时请核对内容、指定处理人并确认截止时间。" : "请对照招标原件核验；摘录、日期和适用条件不代表已获正式确认。" %></p>
      <% entries = @analysis.public_send(field) %>
      <% if entries.empty? %><p class="mt-3 text-sm text-slate-500">尚未整理，请补充原文或人工录入。</p><% else %>
        <ol class="mt-3 space-y-3 text-sm leading-6 text-slate-700">
          <% entries.each_with_index do |entry, index| %>
            <li class="border-t border-slate-100 pt-3"><p class="whitespace-pre-wrap break-words"><%= index + 1 %>. <%= entry %></p>
              <% if field == "suggested_tasks" && policy(WorkflowTask.new(project: @analysis.project, record: @analysis)).create? %>
                <%= link_to "核对并创建任务", new_project_workflow_task_path(@analysis.project, record_ref: "BidAnalysis:#{@analysis.public_id}", suggested_task_index: index), class: "mt-2 inline-flex text-xs font-semibold text-cyan-800" %>
              <% end %>
            </li>
          <% end %>
        </ol>
      <% end %>
    </article>
  <% end %>
</section>
