<section class="mt-5 overflow-hidden rounded-lg border border-slate-200 bg-white">
  <div class="flex items-center justify-between border-b border-slate-200 p-4"><div><h2 class="font-bold">逐项模拟评分</h2><p class="mt-1 text-xs text-slate-500">当前自评分 <%= number_with_precision(@scoring.awarded, precision: 2) %> / 已录入满分 <%= number_with_precision(@scoring.maximum, precision: 2) %>；完整量表按 100 分检查，不预测中标。</p></div><%= link_to "登记评分", new_bid_analysis_bid_score_path(@analysis), class: "rounded-md bg-slate-900 px-3 py-2 text-sm text-white" if policy(@analysis).update? %></div>
  <% if @scoring.issues.any? %><div role="status" class="border-b border-amber-200 bg-amber-50 p-4 text-xs text-amber-900"><p class="font-bold">待完善，不能完成评分复核</p><ul class="mt-2 list-disc space-y-1 pl-4"><% @scoring.issues.each do |issue| %><li><%= issue %></li><% end %></ul></div><% end %>
  <div class="overflow-x-auto"><table class="ledger-table"><caption class="sr-only">逐评分点的自评与证据</caption><thead><tr><th scope="col">评分点</th><th scope="col" class="numeric">满分</th><th scope="col" class="numeric">自评分</th><th scope="col">规则与扣分依据</th><th scope="col">证据 / 状态</th><th scope="col">操作</th></tr></thead><tbody>
    <% @scoring.rows.each do |row| %><tr><td><%= row.criterion %></td><td class="numeric"><%= number_with_precision(row.maximum, precision: 2) %></td><td class="numeric"><%= number_with_precision(row.awarded, precision: 2) %></td><td class="max-w-sm whitespace-pre-wrap text-xs"><%= row.rationale %></td><td class="text-xs"><% if !row.active? %>已停用<% elsif !@analysis.criteria.include?(row.criterion) %>原评分点已变更<% elsif !row.requires_evidence? %>规则不要求原件：<%= row.evidence_exception %><% elsif row.project_document %><%= link_to row.project_document.original_filename, project_project_document_path(@analysis.project, row.project_document), class: "text-cyan-700" %><p><%= row.page_reference %></p><% else %>见下方资料库引用<% end %><% row.evidence_issues.each do |issue| %><p class="mt-1 text-amber-700"><%= issue %></p><% end %></td><td><%= link_to "维护", edit_bid_analysis_bid_score_path(@analysis, row), class: "text-sm font-semibold text-cyan-700" if policy(@analysis).update? %></td></tr><% end %>
    <% if @scoring.rows.empty? %><tr><td colspan="6" class="text-center text-slate-500">尚未登记逐项分值。现有总分仅为历史录入或 AI 参考值，并非逐项复核结果。</td></tr><% end %>
  </tbody></table></div>
</section>
