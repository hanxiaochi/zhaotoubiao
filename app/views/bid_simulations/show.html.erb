<% content_for :page_title, "完整投标模拟审核" %>
<%= link_to "返回投标分析", @simulation.bid_analysis, class: "text-sm text-cyan-700" %>
<div class="mt-3 flex justify-between gap-4"><div><h1 class="text-2xl font-bold"><%= @simulation.title %></h1><p class="mt-2 text-sm text-slate-500">来源：<%= @simulation.source_title %> · <%= @simulation.source_text.length %> 字符 · <%= @simulation.rubric.size %> 个评分点 · 提交人 <%= @simulation.created_by.name %></p></div><% if policy(@simulation).create? && @simulation.status == "draft" && @simulation.current_basis? %><%= button_to "发起 AI 模拟审核", ai_suggest_bid_simulation_path(@simulation), class: "rounded-md bg-cyan-800 px-4 py-2 text-sm text-white" %><% end %></div>
<% unless @simulation.current_basis? %><div role="status" class="mt-4 rounded-md border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">当前文档或评分标准已变化，本批次只保留历史记录。请新建审核批次，不将旧结果当作当前文件结论。</div><% end %>
<section class="mt-4 rounded-lg border border-slate-200 bg-white p-4"><h2 class="font-bold">模拟结果</h2><p class="mt-2 text-sm"><%= @simulation.status == "reviewed" ? "AI 建议已由人工批准保留" : "尚无经人工批准的结果" %> · 汇总分：<%= @simulation.total_score.nil? ? "无法可靠汇总 / 待核" : number_with_precision(@simulation.total_score, precision: 2) %> / 100</p><p class="mt-1 text-xs text-amber-800">结果独立于人工自评分，不代表中标概率、正式评标意见或资质真实性。任何条目无法判断时不生成总分。</p></section>
<% if @simulation.results.any? %><%= render "results", results: @simulation.results, warnings: @simulation.warnings, total_score: @simulation.total_score %><% end %>
<section class="mt-4 rounded-lg border border-slate-200 bg-white p-4"><h2 class="font-bold">生成与复核任务</h2><% @runs.each do |run| %><div class="flex items-center justify-between border-b border-slate-100 py-3 text-sm"><%= link_to "查看模型原文与人工审批 · #{l(run.created_at, format: :short)}", run, class: "text-cyan-700" %><%= status_badge(run.status) %></div><% end %><% if @runs.empty? %><p class="mt-2 text-sm text-slate-500">尚未发起 AI 调用。</p><% end %></section>
<details class="mt-4 rounded-lg border border-slate-200 bg-white p-4"><summary class="cursor-pointer font-semibold">本次全文与量表快照</summary><p class="mt-2 break-all font-mono text-xs text-slate-500">依据指纹：<%= @simulation.basis_sha256 %></p><% @simulation.rubric.each do |row| %><div class="mt-3 border-b border-slate-200 pb-3 text-sm"><p class="font-semibold"><%= row["criterion"] %> / <%= row["maximum"] %></p><p class="mt-1 whitespace-pre-wrap"><%= row["rule"] %></p></div><% end %><pre class="mt-4 max-h-96 overflow-auto whitespace-pre-wrap bg-slate-50 p-3 text-xs leading-6"><%= @simulation.source_text %></pre></details>
