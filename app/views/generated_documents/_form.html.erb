<%= form_with model: document.persisted? ? document : [project, document], class: "space-y-6" do |form| %><%= render "shared/errors", record: document %><%= render "generated_documents/bid_basis_fields", document: document %><div class="grid gap-5 md:grid-cols-2"><div><%= form.label :kind, "文稿类型", class: "mb-1.5 block text-sm font-semibold" %><%= form.select :kind, [["招标文件", "tender_document"], ["技术标", "bid_technical"], ["商务标", "bid_commercial"], ["审计底稿", "audit_workpaper"], ["评估底稿", "appraisal_workpaper"], ["通用文稿", "general"]], {}, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div><div><%= form.label :title, "文稿标题", class: "mb-1.5 block text-sm font-semibold" %><%= form.text_field :title, required: true, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div></div><div><%= form.label :content, "正文", class: "mb-1.5 block text-sm font-semibold" %><%= form.text_area :content, required: true, rows: 26, class: "w-full rounded-xl border border-slate-300 px-4 py-3 font-mono text-sm leading-7" %></div><div class="flex justify-end gap-3 border-t border-slate-100 pt-5"><%= link_to "取消", document.persisted? ? document : project, class: "rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-600" %><%= form.submit "保存草稿", class: "cursor-pointer rounded-xl bg-slate-950 px-5 py-2.5 text-sm font-semibold text-white" %></div><% end %>
