<% content_for :title, "#{@document.title}｜业务文稿" %><% content_for :page_title, "业务文稿" %><div class="mx-auto max-w-5xl"><div class="flex flex-col justify-between gap-4 sm:flex-row"><div><%= link_to "← 返回项目", @document.project, class: "text-sm font-semibold text-cyan-700" %><div class="mt-3"><%= status_badge(@document.status) %></div><h1 class="mt-3 text-2xl font-bold"><%= @document.title %></h1><p class="mt-2 text-sm text-slate-500"><%= GeneratedDocument::KINDS.fetch(@document.kind, @document.kind) %> · 起草人 <%= @document.created_by.name %></p></div><div class="flex h-fit flex-wrap gap-2"><%= link_to "下载 Word", download_docx_generated_document_path(@document), class: "rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold", data: { turbo: false } %><%= link_to "编辑", edit_generated_document_path(@document), class: "rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold" if policy(@document).update? %><%= button_to "AI 完善草稿", ai_suggest_generated_document_path(@document), method: :post, class: "rounded-xl bg-cyan-800 px-4 py-2.5 text-sm font-semibold text-white" if policy(@document).update? %><%= button_to "提交审批", submit_generated_document_path(@document), method: :post, class: "rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white" if policy(@document).submit? %></div></div><div class="mt-6"><%= render "generated_documents/bid_basis" %></div><% if @document.ai_warnings.any? %><section class="mt-6 rounded-2xl border border-amber-200 bg-amber-50 p-5 text-sm text-amber-950"><h2 class="font-bold">AI 草稿待核事项</h2><ul class="mt-2 list-disc space-y-1 pl-5"><% @document.ai_warnings.each do |warning| %><li><%= warning %></li><% end %></ul><p class="mt-3 text-xs">这些事项来自最近一次经人工批准写回的 AI 建议，仍须在业务审批前逐项核对。</p></section><% end %><article class="mt-6 whitespace-pre-wrap rounded-2xl border border-slate-200 bg-white p-7 text-sm leading-8 shadow-sm"><%= @document.content %></article><% if @document.review_note.present? %><div class="mt-4 rounded-xl border border-slate-200 bg-white p-4 text-sm"><span class="font-semibold">审批意见：</span><%= @document.review_note %></div><% end %><% if @ai_runs.any? %><section class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"><div class="border-b border-slate-100 px-5 py-4"><h2 class="font-bold">AI 起草任务</h2><p class="text-xs text-slate-500">AI 建议批准写回后，仍须单独提交业务审批。</p></div><div class="divide-y divide-slate-100"><% @ai_runs.each do |run| %><%= link_to run, class: "flex items-center justify-between gap-3 px-5 py-4 hover:bg-slate-50" do %><div><p class="text-sm font-semibold"><%= l(run.created_at, format: :default) %> · <%= run.model || "等待执行" %></p><p class="mt-1 text-xs text-slate-500"><%= run.evidence_refs.size %> 份来源文件</p></div><%= status_badge(run.status) %><% end %><% end %></div></section><% end %><% if policy(@document).approve? %><section class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-bold">人工审批</h2><div class="mt-4 grid gap-4 md:grid-cols-2"><%= form_with url: approve_generated_document_path(@document), class: "space-y-3" do |form| %><%= form.text_area :review_note, required: true, rows: 3, placeholder: "通过依据与使用边界", class: "w-full rounded-xl border border-slate-300 p-3 text-sm" %><%= form.submit "审批通过", class: "w-full cursor-pointer rounded-xl bg-emerald-700 px-4 py-2.5 text-sm font-semibold text-white" %><% end %><%= form_with url: reject_generated_document_path(@document), class: "space-y-3" do |form| %><%= form.text_area :review_note, required: true, rows: 3, placeholder: "退回原因与修改要求", class: "w-full rounded-xl border border-slate-300 p-3 text-sm" %><%= form.submit "退回修改", class: "w-full cursor-pointer rounded-xl bg-rose-700 px-4 py-2.5 text-sm font-semibold text-white" %><% end %></div></section><% end %></div>
