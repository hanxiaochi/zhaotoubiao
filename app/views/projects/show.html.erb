<div data-controller="workspace">
<% content_for :title, "#{@project.name}｜江苏东华 AI 工作平台" %>
<% content_for :page_title, @project.name %>

<div class="flex flex-col justify-between gap-4 lg:flex-row lg:items-start">
  <div><div class="flex flex-wrap items-center gap-2"><%= status_badge(@project.status) %><span class="rounded-full bg-cyan-50 px-2.5 py-1 text-xs font-semibold text-cyan-800"><%= project_type_label(@project.project_type) %></span></div><h1 class="mt-3 text-2xl font-bold tracking-tight"><%= @project.name %></h1><p class="mt-2 text-sm text-slate-500"><%= @project.code %> · <%= @project.department&.name || "未分配部门" %> · 负责人 <%= @project.owner&.name || "未指定" %></p></div>
  <div class="flex flex-wrap gap-2"><%= link_to "编辑项目", edit_project_path(@project), class: "rounded-md border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold hover:bg-slate-50" if policy(@project).update? %><%= link_to "登记资产", new_project_asset_path(@project), class: "rounded-md border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold hover:bg-slate-50" if policy(Asset.new(project: @project)).create? %><%= link_to "登记债权", new_project_claim_path(@project), class: "rounded-md bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white hover:bg-cyan-800" if policy(Claim.new(project: @project)).create? %></div>
</div>

<div class="mt-4 grid grid-cols-2 gap-3 lg:grid-cols-4">
  <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm"><p class="text-xs font-semibold text-slate-500">资产记录</p><p class="mt-2 text-2xl font-bold"><%= @project.assets.count %></p></div>
  <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm"><p class="text-xs font-semibold text-slate-500">债权申报</p><p class="mt-2 text-2xl font-bold"><%= @project.claims.count %></p></div>
  <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm"><p class="text-xs font-semibold text-slate-500">项目文档</p><p class="mt-2 text-2xl font-bold"><%= @project.project_documents.count %></p></div>
  <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm"><p class="text-xs font-semibold text-slate-500">未收费用</p><p class="mt-2 text-xl font-bold"><%= money(@project.fees.sum("CASE WHEN receivable > received THEN receivable - received ELSE 0 END")) %></p></div>
</div>

<div class="desktop-toolbar" aria-label="项目操作">
  <span class="toolbar-label">业务操作</span>
  <%= link_to "接管登记", new_project_intake_item_path(@project) if policy(IntakeItem.new(project: @project)).create? %>
  <%= link_to "上传文件", new_project_project_document_path(@project) if policy(ProjectDocument.new(project: @project)).create? %>
  <% if policy(@project).update? %><%= link_to "新增收费", new_project_fee_path(@project) %><% end %>
  <%= link_to "投标分析", new_project_bid_analysis_path(@project) if policy(BidAnalysis.new(project: @project)).create? %>
  <%= link_to "新建文稿", new_project_generated_document_path(@project) if policy(GeneratedDocument.new(project: @project)).create? %>
  <%= link_to "发起审批", new_project_workflow_task_path(@project) if policy(WorkflowTask.new(project: @project)).create? %>
</div>

<nav class="workspace-tabs" aria-label="项目业务分区">
  <% [["all", "全部业务"], ["overview", "项目总览"], ["claims", "债权与资产"], ["documents", "文件与文稿"], ["progress", "费用与进度"]].each do |group, label| %>
    <button type="button" data-workspace-target="button" data-group="<%= group %>" data-action="workspace#filter" aria-pressed="<%= group == "all" %>"><%= label %></button>
  <% end %>
</nav>
<div class="mt-4"><%= render "delivery_controls" %></div>
<div class="mt-4 grid gap-4 xl:grid-cols-[minmax(0,1.5fr)_minmax(320px,0.75fr)]">
  <div class="space-y-4">
    <% if @bid_analyses.any? || @generated_documents.any? %>
      <section data-workspace-target="panel" data-group="documents" class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm"><div class="border-b border-slate-100 px-4 py-3"><h2 class="font-bold">投标分析与业务文稿</h2><p class="text-xs text-slate-500">草稿、复核与审批状态 · <%= link_to "全部投标分析", ledger_project_path(@project, kind: "bids"), class: "font-semibold text-cyan-700" %></p></div><div class="divide-y divide-slate-100"><% @bid_analyses.each do |analysis| %><%= link_to analysis, class: "flex items-center justify-between gap-3 px-4 py-3 hover:bg-slate-50" do %><div><p class="font-semibold">评分点与风险分析</p><p class="mt-1 text-xs text-slate-500"><%= analysis.criteria.size %> 个评分点 · 历史参考分 <%= analysis.simulated_score || "—" %></p></div><%= status_badge(analysis.status) %><% end %><% end %><% @generated_documents.each do |document| %><%= link_to document, class: "flex items-center justify-between gap-3 px-4 py-3 hover:bg-slate-50" do %><div><p class="font-semibold"><%= document.title %></p><p class="mt-1 text-xs text-slate-500"><%= document_kind_label(document.kind) %></p></div><%= status_badge(document.status) %><% end %><% end %></div></section>
    <% end %>
    <section data-workspace-target="panel" data-group="claims" class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm"><div class="flex items-center justify-between border-b border-slate-100 px-4 py-3"><div><h2 class="font-bold">资产台账</h2><p class="text-xs text-slate-500">价值变化均形成独立业务版本</p></div><%= link_to "登记资产", new_project_asset_path(@project), class: "text-sm font-semibold text-cyan-700" if policy(Asset.new(project: @project)).create? %></div>
      <% if @assets.any? %><div class="divide-y divide-slate-100"><% @assets.each do |asset| %><div class="flex flex-col justify-between gap-3 px-4 py-3 sm:flex-row sm:items-center"><div><p class="font-semibold"><%= asset.name %></p><p class="mt-1 text-xs text-slate-500"><%= asset.asset_code %> · <%= asset.category %> · <%= status_label(asset.disposal_status) %></p><% asset_flags = asset.risk_flags; if asset_flags.any? %><p class="mt-1 text-xs font-semibold text-amber-700"><%= asset_flags.size %> 项疑似重复或数据缺口待核验</p><% end %></div><div class="flex items-center gap-4"><p class="font-semibold"><%= money(asset.appraisal_value) %></p><%= link_to "查看", project_asset_path(@project, asset), class: "text-sm font-semibold text-cyan-700" %><% if policy(asset).update? %><%= link_to "修改", edit_project_asset_path(@project, asset), class: "text-sm font-semibold text-cyan-700" %><% end %></div></div><% end %></div>
      <% else %><div class="px-5 py-10 text-center text-sm text-slate-500">暂无资产记录。</div><% end %>
    </section>

    <section data-workspace-target="panel" data-group="claims" class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm"><div class="flex items-center justify-between border-b border-slate-100 px-4 py-3"><div><h2 class="font-bold">债权申报台账</h2><p class="text-xs text-slate-500">材料完整性和多级审核状态</p></div><%= link_to "登记债权", new_project_claim_path(@project), class: "text-sm font-semibold text-cyan-700" if policy(Claim.new(project: @project)).create? %></div>
      <% if @claims.any? %><div class="divide-y divide-slate-100"><% @claims.each do |claim| %><%= link_to claim, class: "flex flex-col justify-between gap-3 px-4 py-3 hover:bg-slate-50 sm:flex-row sm:items-center" do %><div><p class="font-semibold"><%= claim.creditor_name %></p><p class="mt-1 text-xs text-slate-500"><%= claim_type_label(claim.claimed_type) %> · 材料完整度 <%= claim.completeness_score || 0 %>%</p></div><div class="flex items-center gap-4"><p class="font-semibold"><%= money(claim.claim_amount, currency: claim.currency) %></p><%= status_badge(claim.status) %></div><% end %><% end %></div>
      <% else %><div class="px-5 py-10 text-center text-sm text-slate-500">暂无债权申报记录。</div><% end %>
    </section>
  </div>

  <aside class="space-y-4">
    <section data-workspace-target="panel" data-group="overview" class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm"><div class="flex items-center justify-between"><h2 class="font-bold">项目成员</h2><span class="text-xs text-slate-400"><%= @memberships.size %> 人</span></div><div class="mt-4 space-y-3"><% @memberships.each do |membership| %><div class="flex items-center justify-between gap-3"><div class="min-w-0"><p class="truncate text-sm font-semibold"><%= membership.user.name %></p><p class="text-xs text-slate-500"><%= membership_role_label(membership.membership_role) %></p></div><% if policy(@project).update? && membership.user_id != @project.owner_id %><%= button_to "移除", project_project_membership_path(@project, membership), method: :delete, data: { turbo_confirm: "确认从该项目移除此成员？" }, class: "text-xs font-semibold text-rose-700" %><% end %></div><% end %></div><% if policy(@project).update? %><%= form_with model: [@project, ProjectMembership.new], class: "mt-4 grid gap-2 border-t border-slate-100 pt-4" do |form| %><%= form.collection_select :user_id, User.active.where.not(id: @memberships.map(&:user_id)).order(:name), :id, :name, { prompt: "选择用户" }, required: true, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %><%= form.select :membership_role, [["项目成员", "member"], ["项目经理", "manager"], ["律师", "lawyer"], ["观察者", "observer"]], {}, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %><%= form.submit "添加成员", class: "cursor-pointer rounded-lg bg-slate-800 px-3 py-2 text-sm font-semibold text-white" %><% end %><% end %></section>
    <section data-workspace-target="panel" data-group="documents" class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm"><div class="flex items-center justify-between border-b border-slate-100 px-4 py-3"><h2 class="font-bold">接管资料</h2><%= link_to "新增", new_project_intake_item_path(@project), class: "text-sm font-semibold text-cyan-700" if policy(IntakeItem.new(project: @project)).create? %></div><% if @intake_items.any? %><div class="divide-y divide-slate-100"><% @intake_items.each do |item| %><%= link_to project_intake_item_path(@project, item), class: "flex items-center justify-between gap-3 px-5 py-3 hover:bg-slate-50" do %><div class="min-w-0"><p class="truncate text-sm font-semibold"><%= item.name %></p><p class="mt-1 text-xs text-slate-500"><%= item.category %> · <%= item.attachments.size %> 个附件</p></div><%= status_badge(item.status) %><% end %><% end %></div><% else %><p class="px-5 py-8 text-center text-sm text-slate-500">尚未建立接管清单。</p><% end %></section>
    <section data-workspace-target="panel" data-group="documents" class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm"><div class="flex items-center justify-between border-b border-slate-100 px-4 py-3"><h2 class="font-bold">项目文件</h2><%= link_to "上传", new_project_project_document_path(@project), class: "text-sm font-semibold text-cyan-700" if policy(ProjectDocument.new(project: @project)).create? %></div><% if @documents.any? %><div class="divide-y divide-slate-100"><% @documents.each do |document| %><%= link_to project_project_document_path(@project, document), class: "block px-5 py-3 hover:bg-slate-50" do %><p class="truncate text-sm font-semibold"><%= document.original_filename %></p><p class="mt-1 text-xs text-slate-500"><%= document_category_label(document.category) %> · <%= number_to_human_size(document.byte_size) %></p><% end %><% end %></div><% else %><p class="px-5 py-8 text-center text-sm text-slate-500">尚未上传项目文件。</p><% end %></section>
    <%= render "fees" %>
    <section data-workspace-target="panel" data-group="overview" class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-bold">项目概况</h2><dl class="mt-4 space-y-3 text-sm"><div class="flex justify-between gap-4"><dt class="text-slate-500">开始日期</dt><dd class="font-medium"><%= @project.start_date || "—" %></dd></div><div class="flex justify-between gap-4"><dt class="text-slate-500">截止日期</dt><dd class="font-medium"><%= @project.due_date || "—" %></dd></div><div class="border-t border-slate-100 pt-3"><dt class="text-slate-500">项目说明</dt><dd class="mt-2 whitespace-pre-line leading-6"><%= @project.description.presence || "暂无说明" %></dd></div></dl></section>
    <section data-workspace-target="panel" data-group="overview" class="rounded-lg border border-cyan-200 bg-cyan-50 p-5"><p class="text-xs font-bold uppercase tracking-wider text-cyan-800">合规提示</p><p class="mt-2 text-sm leading-6 text-cyan-950">系统输出仅作为工作辅助。债权性质、签章真实性、资产价值、审计意见及中标判断须由具备权限的人员复核并作出结论。</p></section>
  </aside>
</div>
</div>
