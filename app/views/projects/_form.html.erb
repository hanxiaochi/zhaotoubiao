<%= form_with model: project, class: "space-y-6" do |form| %>
  <%= render "shared/errors", record: project %>
  <div class="grid gap-5 md:grid-cols-2">
    <div><%= form.label :code, class: "mb-1.5 block text-sm font-semibold" %><%= form.text_field :code, required: true, placeholder: "例如：PH-2026-001", class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div>
    <div><%= form.label :name, class: "mb-1.5 block text-sm font-semibold" %><%= form.text_field :name, required: true, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div>
    <div><%= form.label :project_type, class: "mb-1.5 block text-sm font-semibold" %><%= form.select :project_type, ApplicationHelper::PROJECT_TYPE_LABELS.map { |value, label| [label, value] }, { prompt: "请选择业务类型" }, required: true, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div>
    <div><%= form.label :status, class: "mb-1.5 block text-sm font-semibold" %><%= form.select :status, Project::STATUSES.map { |value| [status_label(value), value] }, {}, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div>
    <div><%= form.label :department_id, "所属部门", class: "mb-1.5 block text-sm font-semibold" %><%= form.collection_select :department_id, Department.where(active: true).order(:name), :id, :name, { include_blank: "暂不分配" }, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div>
    <div class="grid grid-cols-2 gap-3"><div><%= form.label :start_date, class: "mb-1.5 block text-sm font-semibold" %><%= form.date_field :start_date, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div><div><%= form.label :due_date, class: "mb-1.5 block text-sm font-semibold" %><%= form.date_field :due_date, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div></div>
    <div><%= form.label :client_name, "甲方/委托方名称", class: "mb-1.5 block text-sm font-semibold" %><%= form.text_field :client_name, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div>
    <div><%= form.label :project_category, "招标项目类别", class: "mb-1.5 block text-sm font-semibold" %><%= form.text_field :project_category, placeholder: "工程、服务、采购", class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div>
    <div><%= form.label :tender_method, "招标方式", class: "mb-1.5 block text-sm font-semibold" %><%= form.text_field :tender_method, placeholder: "公开招标、邀请招标、询价", class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div>
    <div><%= form.label :budget_amount, "项目预算", class: "mb-1.5 block text-sm font-semibold" %><%= form.number_field :budget_amount, min: 0, step: 0.01, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div>
  </div>
  <div><%= form.label :description, class: "mb-1.5 block text-sm font-semibold" %><%= form.text_area :description, rows: 5, placeholder: "记录项目范围、委托要求和关键边界", class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div>
  <div class="rounded-xl border border-amber-200 bg-amber-50 p-4"><%= form.label :archive_reason, "归档原因/归档说明", class: "mb-1.5 block text-sm font-semibold text-amber-950" %><%= form.text_area :archive_reason, rows: 3, placeholder: "状态选择“已归档”时必填，说明结项依据、资料完整性和遗留事项", class: "w-full rounded-xl border border-amber-300 bg-white px-3.5 py-2.5" %><p class="mt-1.5 text-xs text-amber-800">系统会自动记录归档人和归档时间；重新转为在办状态时清除归档信息。</p></div>
  <div class="flex items-center justify-end gap-3 border-t border-slate-100 pt-5"><%= link_to "取消", project.persisted? ? project_path(project) : projects_path, class: "rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-100" %><%= form.submit project.persisted? ? "保存修改" : "创建项目", class: "cursor-pointer rounded-xl bg-slate-950 px-5 py-2.5 text-sm font-semibold text-white hover:bg-cyan-800" %></div>
<% end %>
