<section data-workspace-target="panel" data-group="progress" class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
  <div class="flex items-center justify-between border-b border-slate-100 px-4 py-3"><div><h2 class="font-bold">收费台账</h2><%= link_to "完整收费台账", project_fees_path(@project), class: "text-xs font-semibold text-cyan-700" %></div><% if policy(@project).update? %><%= link_to "新增", new_project_fee_path(@project), class: "text-sm font-semibold text-cyan-700" %><% end %></div>
  <% if @fees.any? %><div class="divide-y divide-slate-100"><% @fees.each do |fee| %><%= link_to project_fee_path(@project, fee), class: "flex items-center justify-between gap-3 px-5 py-3 hover:bg-slate-50" do %><div><p class="text-sm font-semibold"><%= Fee::TYPE_LABELS.fetch(fee.fee_type) %></p><p class="mt-1 text-xs text-slate-500">已收 <%= money(fee.received) %></p></div><div class="text-right"><p class="text-sm font-bold">未收 <%= money(fee.outstanding) %></p><% if fee.overpaid.positive? %><p class="text-xs text-amber-700">溢收 <%= money(fee.overpaid) %></p><% end %></div><% end %><% end %></div><% else %><p class="px-5 py-8 text-center text-sm text-slate-500">尚无收费记录。</p><% end %>
</section>
