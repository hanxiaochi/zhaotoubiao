<nav aria-label="完整项目台账" class="mb-3 flex flex-wrap gap-2">
  <% ProjectsController::LEDGERS.each do |kind, definition| %><%= link_to definition.first, ledger_project_path(@project, kind: kind), class: "rounded-md border border-slate-200 bg-white px-3 py-1.5 text-sm font-semibold text-cyan-800" %><% end %>
  <%= link_to "费用台账", project_fees_path(@project), class: "rounded-md border border-slate-200 bg-white px-3 py-1.5 text-sm font-semibold text-cyan-800" %>
</nav>
<% if @project.status == "archived" %>
  <div class="mb-3 rounded-md border border-amber-200 bg-amber-50 p-4">
    <p class="font-semibold">归档记录</p><p class="mt-2 text-sm"><%= @project.archive_reason %></p>
    <p class="mt-2 text-xs text-slate-600"><%= @project.archived_by&.name || "历史记录未登记归档人" %> · <%= @project.archived_at ? l(@project.archived_at, format: :short) : "归档时间待补录" %></p>
  </div>
<% end %>
<div class="mb-4 grid gap-4 lg:grid-cols-2">
  <section data-workspace-target="panel" data-group="progress" class="rounded-lg border border-slate-200 bg-white p-4">
    <div class="flex items-center justify-between"><h2 class="font-bold">项目进度节点</h2><% if policy(@project).update? %><%= link_to "新增节点", new_project_project_milestone_path(@project), class: "text-sm font-semibold text-cyan-700" %><% end %></div>
    <% @milestones.each do |item| %><div class="mt-3 border-t border-slate-100 pt-3"><p class="text-sm font-semibold"><%= item.title %> · <%= status_label(item.status) %><%= " · 已超期" if item.overdue? %></p><p class="mt-1 text-xs text-slate-500"><%= item.stage %> · <%= item.owner&.name || "未分配" %> · <%= item.due_on ? l(item.due_on) : "未设日期" %></p><% if policy(item).update? %><%= link_to "维护节点", edit_project_project_milestone_path(@project, item), class: "text-xs text-cyan-700" %><% end %></div><% end %>
    <% if @milestones.empty? %><p class="mt-4 text-sm text-slate-500">尚无进度节点。</p><% end %>
  </section>
  <section data-workspace-target="panel" data-group="claims" class="rounded-lg border border-slate-200 bg-white p-4">
    <div class="flex items-center justify-between"><h2 class="font-bold">债权材料清单</h2><% if policy(@project).update? %><%= link_to "配置清单", new_project_claim_checklist_path(@project), class: "text-sm font-semibold text-cyan-700" %><% end %></div>
    <% @claim_checklists.each do |item| %><div class="mt-3 border-t border-slate-100 pt-3"><p class="text-sm font-semibold"><%= item.name %> · <%= item.active? ? "启用" : "停用" %></p><p class="mt-1 text-xs text-slate-500"><%= claim_type_label(item.claim_type) %> · <%= item.material_types.size %> 项</p><% if policy(item).update? %><%= link_to "维护清单", edit_project_claim_checklist_path(@project, item), class: "text-xs text-cyan-700" %><% end %></div><% end %>
    <% if @claim_checklists.empty? %><p class="mt-4 text-sm text-slate-500">当前使用默认七项清单。</p><% end %>
  </section>
</div>
<section data-workspace-target="panel" data-group="progress" class="mb-4 overflow-x-auto rounded-lg border border-slate-200 bg-white p-4">
  <h2 class="font-bold">项目收费汇总</h2>
  <p class="mt-1 text-xs text-slate-500">按费用类型汇总全部记录；明细和收款状态请查看费用台账。</p>
  <table class="mt-3 w-full text-left text-sm"><thead><tr><th scope="col" class="p-2">费用</th><th scope="col" class="p-2">应收</th><th scope="col" class="p-2">实收</th><th scope="col" class="p-2">未收</th><th scope="col" class="p-2">溢收</th></tr></thead><tbody>
    <% @fee_summary.each do |row| %><tr class="border-t border-slate-100"><td class="p-2"><%= Fee::TYPE_LABELS.fetch(row[:kind]) %></td><td class="p-2"><%= money(row[:receivable]) %></td><td class="p-2"><%= money(row[:received]) %></td><td class="p-2"><%= money(row[:outstanding]) %></td><td class="p-2"><%= money(row[:overpaid]) %></td></tr><% end %>
  </tbody></table>
  <% if @fee_summary.empty? %><p class="mt-3 text-sm text-slate-500">尚无收费记录。</p><% end %>
</section>
