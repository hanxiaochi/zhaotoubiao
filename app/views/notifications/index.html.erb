<% content_for :title, "通知｜江苏东华 AI 工作平台" %><% content_for :page_title, "通知" %><div><h1 class="text-2xl font-bold">我的通知</h1><p class="mt-2 text-sm text-slate-500">最近 100 条项目分配与流程通知。</p></div><div class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"><% @notifications.each do |notification| %><%= button_to notification_path(notification), method: :patch, class: "block w-full border-b border-slate-100 px-5 py-4 text-left hover:bg-slate-50" do %><div class="flex justify-between gap-4"><div><p class="font-semibold <%= 'text-slate-500' if notification.read_at %>"><%= notification.title %></p><p class="mt-1 text-sm text-slate-500"><%= notification.body %></p></div><div class="shrink-0 text-xs text-slate-400"><%= l(notification.created_at, format: :short) %><%= " · 未读" unless notification.read_at %></div></div><% end %><% end %><% unless @notifications.any? %><p class="py-14 text-center text-sm text-slate-500">暂无通知。</p><% end %></div>
