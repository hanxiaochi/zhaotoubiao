<% content_for :title, "审批任务｜江苏东华 AI 工作平台" %><% content_for :page_title, "审批任务" %><div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><h1 class="text-2xl font-bold">审批任务</h1><p class="mt-2 text-sm text-slate-500">显示您负责或有权查看的流程任务，按截止时间排序。</p></div><%= form_with url: workflow_tasks_path, method: :get do |form| %><%= form.select :status, options_for_select([["全部状态", ""], ["待处理", "pending"], ["处理中", "active"], ["已通过", "approved"], ["已驳回", "rejected"], ["已退回", "returned"]], params[:status]), {}, onchange: "this.form.requestSubmit()", class: "rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm" %><% end %></div><div class="mt-6 space-y-3"><% @tasks.each do |task| %><%= link_to task, class: "flex flex-col justify-between gap-3 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm hover:border-cyan-300 sm:flex-row sm:items-center" do %><div><h2 class="font-bold"><%= task.stage %></h2><p class="mt-2 text-sm text-slate-500"><%= task.project.name %> · 处理人 <%= task.assignee&.name || "未分配" %> · <%= task.record_type %></p></div><div class="text-right"><%= status_badge(task.status) %><p class="mt-2 text-xs text-slate-500"><%= task.due_at ? "截止 #{l(task.due_at, format: :short)}" : "无截止时间" %></p></div><% end %><% end %></div><% unless @tasks.any? %><div class="mt-6 rounded-2xl border border-dashed border-slate-300 py-16 text-center text-sm text-slate-500">暂无审批任务。</div><% end %>
