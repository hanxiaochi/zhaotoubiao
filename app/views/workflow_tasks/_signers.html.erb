<fieldset class="rounded-xl border border-cyan-200 bg-cyan-50 p-4">
  <legend class="px-2 text-sm font-bold text-cyan-900">多人会签（可选）</legend>
  <p class="text-xs leading-6 text-cyan-900">选择会签人后，每人单独提交意见，全部通过才完成；任一退回或驳回即停止本轮。未选择则由下方处理人办理。</p>
  <div class="mt-3 grid gap-3 sm:grid-cols-2">
    <% @assignees.each do |user| %>
      <label class="flex items-center gap-2 rounded-lg bg-white p-3 text-sm"><%= check_box_tag "workflow_task[signer_ids][]", user.id, @task.workflow_signatures.any? { |signature| signature.user_id == user.id }, id: "signer_#{user.id}", class: "size-4" %><%= user.name %></label>
    <% end %>
  </div>
</fieldset>
