<% content_for :title, "#{@task.stage}｜审批任务" %><% content_for :page_title, "审批任务" %><%= render "claim_gate" %><%= render "signatures" %><div class="mx-auto max-w-5xl"><%= link_to "← 返回任务列表", workflow_tasks_path, class: "text-sm font-semibold text-cyan-700" %><div class="mt-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><div class="flex flex-col justify-between gap-4 sm:flex-row"><div><%= status_badge(@task.status) %><h1 class="mt-3 text-2xl font-bold"><%= @task.stage %></h1><p class="mt-2 text-sm text-slate-500"><%= @task.project.name %> · <%= workflow_record_label(@task.record_type) %> · 处理人 <%= @task.assignee&.name || "未分配" %></p></div><p class="text-sm text-slate-500"><%= @task.due_at ? "截止 #{l(@task.due_at, format: :default)}" : "无截止时间" %></p></div></div><div class="mt-6 grid gap-6 lg:grid-cols-[1fr_360px]"><section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="font-bold">处理轨迹</h2><% if @events.any? %><div class="mt-4 space-y-4"><% @events.each do |event| %><div class="border-l-2 border-cyan-500 pl-4"><div class="flex justify-between gap-3"><p class="text-sm font-semibold"><%= event.actor.name %> · <%= workflow_decision_label(event.decision) %></p><p class="text-xs text-slate-400"><%= l(event.created_at, format: :default) %></p></div><p class="mt-2 text-sm leading-6 text-slate-600"><%= event.comment %></p></div><% end %></div><% else %><p class="mt-4 text-sm text-slate-500">尚无处理意见。</p><% end %></section><% if policy(@task).decide? %><section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-bold">提交处理意见</h2><%= form_with url: decide_workflow_task_path(@task), class: "mt-4 space-y-4" do |form| %><div><%= form.label :decision, "处理结果", class: "mb-1.5 block text-sm font-semibold" %><%= form.select :decision, [["通过", "approve"], ["驳回", "reject"], ["退回修改", "return"], ["完成", "complete"], ["仅记录意见", "comment"]], {}, class: "w-full rounded-xl border border-slate-300 px-3 py-2.5" %></div><div><%= form.label :comment, "处理说明", class: "mb-1.5 block text-sm font-semibold" %><%= form.text_area :comment, required: true, rows: 5, class: "w-full rounded-xl border border-slate-300 p-3 text-sm" %></div><%= form.submit "记录处理意见", class: "w-full cursor-pointer rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white" %><% end %></section><% end %></div></div>
