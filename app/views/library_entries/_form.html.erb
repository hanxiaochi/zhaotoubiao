<%= form_with model: @entry, class: "mt-4 rounded-lg border border-slate-200 bg-white p-5" do |f| %>
  <% if @entry.errors.any? %><div role="alert" class="mb-4 rounded-md bg-rose-50 p-3 text-sm text-rose-800"><%= @entry.errors.full_messages.to_sentence %></div><% end %>
  <div class="grid gap-4 lg:grid-cols-2">
    <div><%= f.label :title, "资料名称", class: "block text-sm font-semibold" %><%= f.text_field :title, required: true, class: "mt-1 w-full rounded-md border border-slate-300 p-2" %></div>
    <div><%= f.label :organization, "所属企业 / 案例委托单位", class: "block text-sm font-semibold" %><%= f.text_field :organization, required: true, class: "mt-1 w-full rounded-md border border-slate-300 p-2" %></div>
    <div><%= f.label :kind, "资料类别", class: "block text-sm font-semibold" %><%= f.select :kind, LibraryEntry::KINDS.map { |k,v| [v,k] }, {}, class: "mt-1 w-full rounded-md border border-slate-300 p-2" %></div>
    <div><%= f.label :reference_number, "证书 / 合同编号", class: "block text-sm font-semibold" %><%= f.text_field :reference_number, class: "mt-1 w-full rounded-md border border-slate-300 p-2" %></div>
    <div><%= f.label :issued_on, "签发 / 案例完成日期", class: "block text-sm font-semibold" %><%= f.date_field :issued_on, class: "mt-1 w-full rounded-md border border-slate-300 p-2" %></div>
    <div><%= f.label :expires_on, "有效截止日期（如适用）", class: "block text-sm font-semibold" %><%= f.date_field :expires_on, class: "mt-1 w-full rounded-md border border-slate-300 p-2" %></div>
    <div><%= f.label :status, "使用状态", class: "block text-sm font-semibold" %><%= f.select :status, [["使用中", "active"], ["归档停用", "archived"]], {}, class: "mt-1 w-full rounded-md border border-slate-300 p-2" %></div>
    <div><%= f.label :documents, "追加证明附件", class: "block text-sm font-semibold" %><%= f.file_field :documents, multiple: true, class: "mt-1 w-full rounded-md border border-slate-300 p-2 text-sm" %><p class="mt-1 text-xs text-slate-500">支持 PDF、Office、图片、TXT/CSV，单个不超过 50 MB；追加不覆盖历史原件。保存失败后需重新选择文件。</p></div>
    <div class="lg:col-span-2"><%= f.label :description, "资质范围 / 案例概述、核验及授权说明", class: "block text-sm font-semibold" %><%= f.text_area :description, rows: 6, required: true, class: "mt-1 w-full rounded-md border border-slate-300 p-3 text-sm" %></div>
  </div>
  <div class="mt-5 flex items-center gap-4"><%= f.submit "保存资料", class: "cursor-pointer rounded-md bg-slate-900 px-5 py-2 text-sm text-white" %><%= link_to "取消", @entry.persisted? ? library_entry_path(@entry) : library_entries_path, class: "text-sm text-slate-600" %></div>
<% end %>
