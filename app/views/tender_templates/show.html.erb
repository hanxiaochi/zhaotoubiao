<% content_for :title, "#{@template.name}｜招标模板" %><% content_for :page_title, "招标模板" %><div class="mx-auto max-w-5xl"><div class="flex justify-between gap-4"><div><%= link_to "← 返回模板库", tender_templates_path, class: "text-sm font-semibold text-cyan-700" %><h1 class="mt-3 text-2xl font-bold"><%= @template.name %></h1><p class="mt-2 text-sm text-slate-500"><%= @template.project_category %> · <%= @template.tender_method %> · v<%= @template.revision_number %></p></div><% if policy(@template).update? %><%= link_to "编辑模板", edit_tender_template_path(@template), class: "h-fit rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold" %><% end %></div><article class="mt-6 whitespace-pre-wrap rounded-2xl border border-slate-200 bg-white p-7 text-sm leading-8 shadow-sm"><%= @template.body %></article><section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="font-bold">选择项目生成招标文件草稿</h2><p class="mt-1 text-xs text-slate-500">系统替换项目、甲方、招标方式、预算和日期占位符；未填写内容保留“待填写”，生成后必须人工校核并审批。</p><%= render "project_search" %><% if @template.active? && @projects.any? %><div class="mt-4 grid gap-3 sm:grid-cols-2"><% @projects.each do |project| %><% next unless policy(project).update? %><%= link_to new_project_generated_document_path(project, template_id: @template.public_id, kind: "tender_document"), class: "rounded-xl border border-slate-200 px-4 py-3 hover:border-cyan-300 hover:bg-cyan-50" do %><p class="text-sm font-semibold"><%= project.name %></p><p class="mt-1 text-xs text-slate-500"><%= project.code %> · <%= project.client_name.presence || "甲方待填写" %></p><% end %><% end %></div><% else %><p class="mt-4 rounded-xl bg-slate-50 px-4 py-8 text-center text-sm text-slate-500">暂无您可访问的招标代理或投标项目。</p><% end %></section></div>
<%= render "pagination" %>
