<%= form_with model: template, class: "space-y-6" do |form| %><%= render "shared/errors", record: template %><div class="grid gap-5 md:grid-cols-2"><div><%= form.label :name, "模板名称", class: "mb-1.5 block text-sm font-semibold" %><%= form.text_field :name, required: true, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div><div><%= form.label :project_category, "项目类别", class: "mb-1.5 block text-sm font-semibold" %><%= form.text_field :project_category, required: true, placeholder: "工程、服务、货物等", class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div><div><%= form.label :tender_method, "招标方式", class: "mb-1.5 block text-sm font-semibold" %><%= form.text_field :tender_method, required: true, placeholder: "公开招标、邀请招标等", class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div><div class="flex items-center gap-3 pt-7"><%= form.check_box :active, class: "size-4 rounded border-slate-300" %><%= form.label :active, "启用模板", class: "text-sm font-semibold" %></div></div><div><%= form.label :body, "模板正文", class: "mb-1.5 block text-sm font-semibold" %><%= form.text_area :body, required: true, rows: 20, placeholder: "可使用明确的章节占位符，如【项目名称】、【采购范围】。", class: "w-full rounded-xl border border-slate-300 px-3.5 py-3 font-mono text-sm leading-6" %></div><div class="flex justify-end gap-3 border-t border-slate-100 pt-5"><%= link_to "取消", template.persisted? ? template : tender_templates_path, class: "rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-600" %><%= form.submit template.persisted? ? "保存新版本" : "创建模板", class: "cursor-pointer rounded-xl bg-slate-950 px-5 py-2.5 text-sm font-semibold text-white" %></div><% end %>
