<%= form_with url: tender_template_path(@template), method: :get, class: "mt-4 flex gap-3" do |form| %>
  <%= form.text_field :q, value: params[:q], placeholder: "按项目名称或编号查找", aria: { label: "查找起草项目" }, class: "min-w-0 flex-1 rounded-md border border-slate-300 px-3 py-2 text-sm" %>
  <%= form.submit "查找项目", class: "cursor-pointer rounded-md bg-slate-950 px-4 py-2 text-sm font-semibold text-white" %>
<% end %>
<% unless @template.active? %><p class="mt-3 rounded-md bg-amber-50 p-3 text-sm text-amber-900">模板已停用，只能查看历史内容，不能用于新建文稿。</p><% end %>
