<% content_for :title, "招标模板库｜江苏东华 AI 工作平台" %><% content_for :page_title, "招标模板库" %><div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><h1 class="text-2xl font-bold">招标模板库</h1><p class="mt-2 text-sm text-slate-500">按项目类别和招标方式管理可复用底稿；每次修改自动递增版本并保留审计轨迹。</p></div><div class="flex gap-2"><% if policy(TenderSource).index? %><%= link_to "数据源配置", tender_sources_path, class: "rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold" %><% end %><% if policy(TenderTemplate).create? %><%= link_to "新建模板", new_tender_template_path, class: "rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white" %><% end %></div></div><%= render "filters" %><div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3"><% @templates.each do |template| %><%= link_to template, class: "rounded-2xl border border-slate-200 bg-white p-5 shadow-sm hover:border-cyan-300" do %><div class="flex items-center justify-between"><span class="rounded-full bg-cyan-50 px-2.5 py-1 text-xs font-semibold text-cyan-800"><%= template.tender_method %></span><span class="text-xs text-slate-400">v<%= template.revision_number %></span></div><h2 class="mt-4 font-bold"><%= template.name %></h2><p class="mt-2 text-sm text-slate-500"><%= template.project_category %> · <%= template.active? ? "启用" : "停用" %></p><p class="mt-4 line-clamp-3 whitespace-pre-line text-sm leading-6 text-slate-600"><%= truncate(template.body, length: 120) %></p><% end %><% end %></div><% unless @templates.any? %><div class="mt-6 rounded-2xl border border-dashed border-slate-300 py-16 text-center text-sm text-slate-500">模板库为空。</div><% end %>
<%= render "pagination" %>
