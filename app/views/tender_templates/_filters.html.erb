<%= form_with url: tender_templates_path, method: :get, class: "mt-5 grid gap-3 rounded-lg border border-slate-200 bg-white p-4 md:grid-cols-4" do |form| %>
  <%= form.text_field :q, value: params[:q], placeholder: "搜索模板名称", aria: { label: "搜索模板名称" }, class: "rounded-md border border-slate-300 px-3 py-2 text-sm" %>
  <%= form.text_field :category, value: params[:category], placeholder: "项目类别，如服务", aria: { label: "筛选项目类别" }, class: "rounded-md border border-slate-300 px-3 py-2 text-sm" %>
  <%= form.text_field :method, value: params[:method], placeholder: "招标方式，如公开招标", aria: { label: "筛选招标方式" }, class: "rounded-md border border-slate-300 px-3 py-2 text-sm" %>
  <%= form.submit "筛选模板", class: "cursor-pointer rounded-md bg-slate-950 px-4 py-2 text-sm font-semibold text-white" %>
<% end %>
