<%= form_with model: [project, fee], class: "space-y-6" do |form| %><%= render "shared/errors", record: fee %><div class="grid gap-5 md:grid-cols-2"><div><%= form.label :fee_type, "费用类型", class: "mb-1.5 block text-sm font-semibold" %><%= form.select :fee_type, [["报名费", "registration"], ["专家费", "expert"], ["代理服务费", "agency"], ["其他", "other"]], {}, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div><div><%= form.label :invoice_status, "开票状态", class: "mb-1.5 block text-sm font-semibold" %><%= form.select :invoice_status, [["未开票", "not_issued"], ["申请中", "requested"], ["已开票", "issued"], ["无需开票", "not_required"]], {}, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div><div><%= form.label :receivable, "应收金额", class: "mb-1.5 block text-sm font-semibold" %><%= form.number_field :receivable, min: 0, step: 0.01, required: true, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div><div><%= form.label :received, "已收金额", class: "mb-1.5 block text-sm font-semibold" %><%= form.number_field :received, min: 0, step: 0.01, required: true, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div><div><%= form.label :received_on, "收款日期", class: "mb-1.5 block text-sm font-semibold" %><%= form.date_field :received_on, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div></div><div><%= form.label :note, "费用说明", class: "mb-1.5 block text-sm font-semibold" %><%= form.text_area :note, rows: 4, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div><div class="flex justify-end gap-3 border-t border-slate-100 pt-5"><%= link_to "取消", project, class: "rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-600" %><%= form.submit fee.persisted? ? "保存修改" : "新增收费记录", class: "cursor-pointer rounded-xl bg-slate-950 px-5 py-2.5 text-sm font-semibold text-white hover:bg-cyan-800" %></div><% end %>
