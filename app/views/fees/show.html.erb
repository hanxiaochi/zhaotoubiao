<% content_for :page_title, "收费记录" %>
<%= link_to "返回完整收费台账", project_fees_path(@project), class: "text-sm font-semibold text-cyan-700" %>
<div class="mt-3 flex items-center justify-between"><div><h1 class="text-2xl font-bold"><%= Fee::TYPE_LABELS.fetch(@fee.fee_type) %></h1><p class="mt-1 text-sm text-slate-500"><%= @project.name %> · <%= @fee.public_id %></p></div><% if policy(@fee).update? %><%= link_to "编辑收费", edit_project_fee_path(@project, @fee), class: "rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold" %><% end %></div>
<div class="mt-5 grid grid-cols-4 gap-3"><% { "应收" => @fee.receivable, "已收" => @fee.received, "未收" => @fee.outstanding, "溢收" => @fee.overpaid }.each do |label, value| %><div class="rounded-lg border border-slate-200 bg-white p-5"><p class="text-xs text-slate-500"><%= label %></p><p class="mt-2 text-2xl font-bold"><%= money(value) %></p></div><% end %></div>
<section class="mt-5 rounded-lg border border-slate-200 bg-white p-6"><h2 class="font-bold">收款信息</h2><dl class="mt-4 grid grid-cols-3 gap-5 text-sm"><div><dt class="text-slate-500">收款状态</dt><dd class="mt-1"><%= status_badge(@fee.payment_status) %></dd></div><div><dt class="text-slate-500">开票状态</dt><dd class="mt-1"><%= Fee::INVOICE_LABELS.fetch(@fee.invoice_status, @fee.invoice_status) %></dd></div><div><dt class="text-slate-500">收款日期</dt><dd class="mt-1"><%= @fee.received_on || "未登记" %></dd></div><div><dt class="text-slate-500">登记人</dt><dd class="mt-1"><%= @fee.created_by.name %></dd></div><div><dt class="text-slate-500">创建时间</dt><dd class="mt-1"><%= l(@fee.created_at, format: :short) %></dd></div><div><dt class="text-slate-500">最后更新</dt><dd class="mt-1"><%= l(@fee.updated_at, format: :short) %></dd></div><div class="col-span-3"><dt class="text-slate-500">费用说明</dt><dd class="mt-2 whitespace-pre-wrap leading-7"><%= @fee.note.presence || "暂无说明" %></dd></div></dl></section>
