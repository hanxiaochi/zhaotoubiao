<% content_for :title, "修改资产｜江苏东华 AI 工作平台" %><% content_for :page_title, "修改资产" %>
<div class="mx-auto max-w-4xl"><div class="mb-6"><%= link_to "← 返回项目", @project, class: "text-sm font-semibold text-cyan-700" %><h1 class="mt-3 text-2xl font-bold">修改 <%= @asset.name %></h1><p class="mt-2 text-sm text-slate-500">当前已有 <%= @asset.asset_versions.count %> 个业务版本；保存后历史数据不会被覆盖。</p></div><%= render "risk_flags" %><div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><%= render "form", project: @project, asset: @asset %></div><section class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"><div class="border-b border-slate-100 px-5 py-4"><h2 class="font-bold">价值与修改历史</h2><p class="mt-1 text-xs text-slate-500">每次保存均记录修改人、原因、快照和评估价值变化。</p></div><% if @versions.any? %><div class="divide-y divide-slate-100"><% @versions.each_with_index do |version, index| %><% previous = @versions[index + 1] %><% delta = previous && version.appraisal_value && previous.appraisal_value ? version.appraisal_value - previous.appraisal_value : nil %><div class="grid gap-2 px-5 py-4 text-sm sm:grid-cols-[1fr_auto]"><div><p class="font-semibold"><%= version.change_reason %></p><p class="mt-1 text-xs text-slate-500"><%= version.changed_by.name %> · <%= l(version.created_at, format: :default) %></p></div><div class="text-left sm:text-right"><p class="font-semibold"><%= money(version.appraisal_value) %></p><p class="mt-1 text-xs <%= delta&.negative? ? "text-rose-700" : "text-emerald-700" %>"><%= delta ? "较前版 #{delta.negative? ? "" : "+"}#{money(delta)}" : "首个版本" %></p></div></div><% end %></div><% else %><p class="px-5 py-8 text-center text-sm text-slate-500">暂无业务版本。</p><% end %></section></div>
