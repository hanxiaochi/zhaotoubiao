<% content_for :page_title, "资产详情" %>
<%= link_to "返回资产台账", ledger_project_path(@project, kind: "assets"), class: "text-sm font-semibold text-cyan-700" %>
<div class="mt-3 flex items-start justify-between gap-4">
  <div><h1 class="text-2xl font-bold"><%= @asset.name %></h1><p class="mt-2 text-sm text-slate-500"><%= @project.name %> · <%= @asset.asset_code %></p></div>
  <% if policy(@asset).update? %><%= link_to "维护资产", edit_project_asset_path(@project, @asset), class: "rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white" %><% end %>
</div>
<section class="mt-4 rounded-lg border border-slate-200 bg-white p-5">
  <h2 class="font-bold">当前登记信息</h2>
  <dl class="mt-4 grid gap-4 md:grid-cols-3">
    <% %w[category address rights_no appraisal_org].each do |field| %><div><dt class="text-sm text-slate-500"><%= Asset.human_attribute_name(field) %></dt><dd class="mt-1 break-words text-sm font-medium"><%= @asset.public_send(field).presence || "未登记" %></dd></div><% end %>
    <div><dt class="text-sm text-slate-500">登记评估价值</dt><dd class="mt-1 text-xl font-bold"><%= @asset.appraisal_value.nil? ? "未登记" : money(@asset.appraisal_value) %></dd></div>
    <div><dt class="text-sm text-slate-500">处置状态</dt><dd class="mt-1"><%= status_badge(@asset.disposal_status) %></dd></div>
  </dl>
</section>
<section class="mt-4 rounded-lg border border-slate-200 bg-white p-5"><h2 class="font-bold">来源与资产特征</h2><p class="mt-3 text-sm"><span class="text-slate-500">合同/来源编号：</span><%= @asset.source_reference.presence || "未登记" %></p><p class="mt-3 whitespace-pre-wrap break-words text-sm text-slate-700"><%= @asset.description.presence || "未登记来源说明" %></p></section>
<%= render "risk_flags" %>
<section class="mt-4 overflow-x-auto rounded-lg border border-slate-200 bg-white">
  <div class="border-b border-slate-100 p-4"><h2 class="font-bold">价值与修改历史</h2><p class="mt-1 text-sm text-slate-500">共 <%= @versions.size %> 个版本；展开可查看当时的登记信息。</p></div>
  <table class="ledger-table"><thead><tr><th scope="col">修改时间 / 人员</th><th scope="col">修改原因与快照</th><th scope="col" class="numeric">登记价值</th><th scope="col" class="numeric">较前版变化</th></tr></thead><tbody>
    <% @versions.each_with_index do |version, index| %>
      <% previous = @versions[index + 1]; delta = previous && version.appraisal_value && previous.appraisal_value ? version.appraisal_value - previous.appraisal_value : nil %>
      <tr><td><%= l(version.created_at, format: :default) %><p class="mt-1 text-sm text-slate-500"><%= version.changed_by.name %></p></td>
        <td><p class="font-medium"><%= version.change_reason %></p><details class="mt-2"><summary class="cursor-pointer text-sm text-cyan-700">查看历史登记信息</summary><dl class="mt-2 space-y-2 text-sm"><% %w[asset_code name category address rights_no appraisal_org disposal_status source_reference description].each do |field| %><div><dt class="text-slate-500"><%= Asset.human_attribute_name(field) %></dt><dd class="break-words"><%= version.snapshot[field].presence || "未登记" %></dd></div><% end %></dl></details></td>
        <td class="numeric"><%= version.appraisal_value.nil? ? "未登记" : money(version.appraisal_value) %></td><td class="numeric"><%= delta ? "#{delta.positive? ? '+' : ''}#{money(delta)}" : (previous ? "无法比较" : "首个版本") %></td></tr>
    <% end %>
    <% if @versions.empty? %><tr><td colspan="4" class="text-center text-slate-500">暂无业务版本。</td></tr><% end %>
  </tbody></table>
</section>
