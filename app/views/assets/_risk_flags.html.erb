<% if @risk_flags.any? %>
  <section class="my-4 rounded-lg border border-amber-200 bg-amber-50 p-5">
    <h2 class="font-bold text-amber-950">疑似重复与待核查线索</h2>
    <p class="mt-2 text-sm leading-6 text-amber-900">名称、地址和来源说明采用字符相似度，仅用于检索线索；同一合同可能对应多个资产。未登记的资产无法凭台账识别遗漏，不能替代现场盘点或专业评估。</p>
    <ul class="mt-3 space-y-3 text-sm text-amber-900">
      <% @risk_flags.each do |flag| %>
        <li class="border-t border-amber-200 pt-3"><p><%= flag["message"] %></p>
          <% flag["related_public_ids"].each do |id| %>
            <% if related = @related_assets[id] %>
              <%= link_to "#{related.asset_code} · #{related.name}", project_asset_path(@project, related), class: "mt-2 inline-flex rounded-md border border-amber-200 bg-white px-3 py-1.5 text-xs font-semibold text-cyan-800" %>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
