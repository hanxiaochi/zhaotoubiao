<% content_for :title, "登录｜江苏东华 AI 工作平台" %>
<div class="rounded-3xl border border-white/10 bg-white p-7 shadow-2xl shadow-black/30">
  <div class="mb-6">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-cyan-700">安全登录</p>
    <h1 class="mt-2 text-2xl font-bold tracking-tight">欢迎回来</h1>
    <p class="mt-2 text-sm text-slate-500">使用事务所内部账户访问业务项目。</p>
  </div>
  <%= form_with url: session_path, class: "space-y-4" do |form| %>
    <div><%= form.label :email, "邮箱", class: "mb-1.5 block text-sm font-semibold" %><%= form.email_field :email, required: true, autofocus: true, autocomplete: "username", class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5 outline-none focus:border-cyan-600 focus:ring-2 focus:ring-cyan-600/20" %></div>
    <div><%= form.label :password, "密码", class: "mb-1.5 block text-sm font-semibold" %><%= form.password_field :password, required: true, autocomplete: "current-password", class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5 outline-none focus:border-cyan-600 focus:ring-2 focus:ring-cyan-600/20" %></div>
    <%= form.submit "登录工作平台", class: "w-full cursor-pointer rounded-xl bg-slate-950 px-4 py-3 font-semibold text-white transition hover:bg-cyan-800" %>
  <% end %>
</div>
