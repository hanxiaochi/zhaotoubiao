<dialog data-controller="confirm" data-action="cancel->confirm#cancel close->confirm#closed" aria-labelledby="confirmation-title" aria-describedby="confirmation-message" class="workbench-confirm">
  <div class="p-6"><p class="text-xs font-semibold text-cyan-700">操作确认</p><h2 id="confirmation-title" class="mt-2 text-xl font-bold text-slate-950">请确认本次操作</h2><p id="confirmation-message" data-confirm-target="message" class="mt-3 whitespace-pre-wrap text-sm leading-7 text-slate-600"></p><div class="mt-6 flex justify-end gap-3"><button type="button" data-confirm-target="cancel" data-action="confirm#cancel" class="rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold">取消操作</button><button type="button" data-action="confirm#accept" class="rounded-md bg-slate-950 px-4 py-2 text-sm font-semibold text-white">确认继续</button></div></div>
</dialog>
