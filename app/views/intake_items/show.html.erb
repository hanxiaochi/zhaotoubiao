<% content_for :title, "#{@intake_item.name}｜接管资料" %><% content_for :page_title, "接管资料详情" %>
<div class="flex items-start justify-between gap-4"><div><%= link_to "← 返回接管台账", ledger_project_path(@project, kind: "intake"), class: "text-sm font-semibold text-cyan-700" %><h1 class="mt-3 text-2xl font-bold"><%= @intake_item.name %></h1><p class="mt-2 text-sm text-slate-500"><%= @project.name %> · <%= @intake_item.category %></p></div><%= link_to "维护资料", edit_project_intake_item_path(@project, @intake_item), class: "rounded-lg bg-slate-950 px-4 py-2 text-sm font-semibold text-white" if policy(@intake_item).update? %></div>
<section class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <dl class="grid gap-6 text-sm md:grid-cols-4"><div><dt class="text-slate-500">交接状态</dt><dd class="mt-2"><%= status_badge(@intake_item.status) %></dd></div><div><dt class="text-slate-500">保管人</dt><dd class="mt-2 font-semibold"><%= @intake_item.custodian.presence || "待登记" %></dd></div><div><dt class="text-slate-500">接收时间</dt><dd class="mt-2"><%= @intake_item.received_at ? l(@intake_item.received_at, format: :default) : "未接收" %></dd></div><div><dt class="text-slate-500">登记人</dt><dd class="mt-2"><%= @intake_item.created_by.name %></dd></div></dl>
  <h2 class="mt-6 border-t border-slate-100 pt-5 font-bold">交接说明</h2><p class="mt-3 whitespace-pre-line text-sm leading-7 text-slate-600"><%= @intake_item.note.presence || "暂无说明" %></p>
</section>
<section class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="font-bold">归属本清单的原始附件</h2><p class="mt-2 text-xs text-slate-500">历史附件保留；每次下载重新检查项目权限并记录审计。</p><div class="mt-4 divide-y divide-slate-100"><% @intake_item.attachments.each do |attachment| %><div class="flex items-center justify-between gap-4 py-3"><span class="text-sm"><%= attachment.filename %> <span class="ml-2 text-xs text-slate-500"><%= number_to_human_size(attachment.byte_size) %></span></span><%= link_to "下载原件", download_project_intake_item_path(@project, @intake_item, attachment_id: attachment.id), class: "text-sm font-semibold text-cyan-700" %></div><% end %><% unless @intake_item.attachments.attached? %><p class="py-4 text-sm text-slate-500">尚未上传附件。</p><% end %></div></section>
