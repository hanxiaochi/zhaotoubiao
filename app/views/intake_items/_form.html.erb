<%= form_with model: [project, intake_item], class: "space-y-6" do |form| %><%= render "shared/errors", record: intake_item %><div class="grid gap-5 md:grid-cols-2"><div><%= form.label :category, "资料类别", class: "mb-1.5 block text-sm font-semibold" %><%= form.text_field :category, required: true, placeholder: "印章、证照、账册、合同、电子数据等", class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div><div><%= form.label :name, "资料名称", class: "mb-1.5 block text-sm font-semibold" %><%= form.text_field :name, required: true, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div><div><%= form.label :status, "接管状态", class: "mb-1.5 block text-sm font-semibold" %><%= form.select :status, [["待接收", "pending"], ["已接收", "received"], ["缺失", "missing"], ["已退还", "returned"], ["已归档", "archived"]], {}, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div><div><%= form.label :custodian, "保管人/交接人", class: "mb-1.5 block text-sm font-semibold" %><%= form.text_field :custodian, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div><div><%= form.label :received_at, "接收时间", class: "mb-1.5 block text-sm font-semibold" %><%= form.datetime_local_field :received_at, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div></div><div><%= form.label :note, "交接说明", class: "mb-1.5 block text-sm font-semibold" %><%= form.text_area :note, rows: 4, class: "w-full rounded-xl border border-slate-300 px-3.5 py-2.5" %></div><div><%= form.label :attachments, "交接附件", class: "mb-1.5 block text-sm font-semibold" %><%= form.file_field :attachments, multiple: true, accept: IntakeItem::ALLOWED_ATTACHMENT_TYPES.join(","), class: "block w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm" %><p class="mt-1.5 text-xs text-slate-500">支持 PDF、Word、Excel、图片及文本，单个文件不超过 50 MB；再次上传会追加，不覆盖已有证据。</p><% if intake_item.attachments.attached? %><div class="mt-3 flex flex-wrap gap-2"><% intake_item.attachments.each do |attachment| %><%= link_to attachment.filename.to_s, download_project_intake_item_path(project, intake_item, attachment_id: attachment.id), data: { turbo: false }, class: "rounded-lg bg-slate-100 px-3 py-2 text-xs font-semibold text-slate-700" %><% end %></div><% end %></div><div class="flex justify-end gap-3 border-t border-slate-100 pt-5"><%= link_to "取消", project, class: "rounded-xl px-4 py-2.5 text-sm font-semibold text-slate-600" %><%= form.submit intake_item.persisted? ? "保存修改" : "加入接管清单", class: "cursor-pointer rounded-xl bg-slate-950 px-5 py-2.5 text-sm font-semibold text-white hover:bg-cyan-800" %></div><% end %>
